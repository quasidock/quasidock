{
  "id": "gnome-text-editor",
  "version": "51.0",
  "name": "GNOME Text Editor",
  "summary": "A simple text editor that remembers your open documents",
  "homepage": "https://apps.gnome.org/TextEditor/",
  "license": "GPL-3.0-or-later",
  "entrypoint": "bin/gnome-text-editor.exe",
  "path": ["bin"],
  "env": { "XDG_DATA_DIRS": "${app}\\share" },
  "permissions": {
    "filesystem": ["cwd"]
  },
  "from": { "gtk": "gtk4:4.24.1@sha256:550c7eddb54fc071caae8955664a76ed418c65e727237ba8585ee6827f4e5ad1" },
  "sdk": {
    "gtksdk": "gtk4-sdk:4.24.1@sha256:7c063e56d0148fbc2ea019ddce1b4368d0aee279ff30b5417bad3e8ad78ca682",
    "cmake": "cmake:4.4.4@sha256:b96b30bb57b5147726b7deef2607917b43972bb896d9f5d3e3082e31368dbeae"
  },
  "cleanup": [
    "/include",
    "/lib",
    "/share/doc",
    "/share/gtk-doc",
    "/share/man",
    "/share/aclocal",
    "/bin/editorconfig.exe",
    "/bin/editorconfig-*.exe",
    "*-config"
  ],
  "stages": [
    {
      "name": "gtksourceview",
      "sources": [
        { "url": "https://download.gnome.org/sources/gtksourceview/5.22/gtksourceview-5.22.0.tar.xz", "sha256": "3ebce33c781e65590a450ecd3ffade480d8e3135b52ee996f1620d6c7dffbbff", "strip": 1 }
      ],
      "build": [
        "meson setup out --prefix=\"$PREFIX\" --buildtype=release -Dbuild-testsuite=false -Dintrospection=disabled -Dvapi=false -Ddocumentation=false -Dsysprof=false",
        "meson install -C out"
      ]
    },
    {
      "name": "libspelling",
      "env": { "CFLAGS": "-IB:/src/libspelling/quasidock" },
      "sources": [
        { "url": "https://download.gnome.org/sources/libspelling/0.4/libspelling-0.4.10.tar.xz", "sha256": "56e3f01a3a18b575beea4c34349f99cdaba316e1f7c271b1231f7bcf5d9af73b", "strip": 1 },
        { "path": "gnome-text-editor/icu-uloc.h", "dest": "quasidock/unicode/uloc.h" }
      ],
      "build": [
        "sed -i \"s/^libicu_dep = dependency('icu-uc')$/libicu_dep = declare_dependency(link_args: ['-licu'])/\" lib/enchant/meson.build",
        "grep -q \"^libicu_dep = declare_dependency(link_args: \\['-licu'\\])$\" lib/enchant/meson.build",
        "meson setup out --prefix=\"$PREFIX\" --buildtype=release -Denchant=enabled -Ddocs=false -Dintrospection=disabled -Dvapi=false -Dsysprof=false",
        "meson install -C out"
      ]
    },
    {
      "name": "editorconfig",
      "sources": [
        { "url": "https://github.com/editorconfig/editorconfig-core-c/archive/refs/tags/v0.12.11.tar.gz", "sha256": "9d8b420b56a969ea3cf784861c72d26fa0e158fa1494d732df2c8a1480d36a5c", "strip": 1 }
      ],
      "build": [
        "cmake -S . -B out -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=\"$PREFIX\" -DBUILD_DOCUMENTATION=OFF",
        "cmake --build out",
        "cmake --install out"
      ]
    },
    {
      "name": "gnome-text-editor",
      "sources": [
        { "url": "https://download.gnome.org/sources/gnome-text-editor/51/gnome-text-editor-51.0.tar.xz", "sha256": "2b76e6da1506346c54b36ba1a3aeedcd28f4cb7d6a8793d217f209456c92dd4c", "strip": 1 },
        { "path": "gtk4-sdk/svg2ico.sh", "dest": "quasidock/svg2ico.sh" }
      ],
      "build": [
        "sed -i \"/^subdir('help')$/d\" meson.build",
        "! grep -q \"subdir('help')\" meson.build",
        "meson setup out --prefix=\"$PREFIX\" --buildtype=release",
        "meson install -C out",
        "sh quasidock/svg2ico.sh \"$PREFIX/share/icons/hicolor/scalable/apps/org.gnome.TextEditor.svg\" \"$PREFIX/share/icons/org.gnome.TextEditor.ico\""
      ]
    }
  ]
}
