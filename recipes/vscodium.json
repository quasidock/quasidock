{
  "id": "vscodium",
  "version": "1.143.17232",
  "name": "VSCodium",
  "summary": "Code editor: Visual Studio Code's source, without Microsoft's branding and telemetry",
  "homepage": "https://vscodium.com/",
  "license": "MIT",
  "entrypoint": "VSCodium.exe",
  "path": ["bin"],
  "layer": "estargz",
  "permissions": {
    "sandbox": "soft",
    "network": true,
    "filesystem": ["cwd"],
    "unsupported": {
      "low": "Windows refuses Chromium's sandbox a window station there, so it exits with code 3; --no-sandbox gets past that, and takes its sandbox from every process",
      "appcontainer": "Windows refuses Chromium's sandbox a window station there, so it exits with code 3; even with --no-sandbox, Node can't resolve paths from a container"
    },
    "host": true
  },
  "from": { "git": "mingit:2.56.0.windows.1@sha256:fc3e29f8e695bba0d168d477395c743f02119ef3a0a56f83cc036449ed7488c7" },
  "sdk": { "busybox": "busybox:FRP-6075-g169694ebd@sha256:3d73278be5092691667ebeecd92ffe034fb6898221024e4859325fb379178d2a" },
  "cleanup": ["/bin/codium-tunnel.exe"],
  "stages": [
    {
      "name": "vscodium",
      "sources": [
        { "url": "https://github.com/VSCodium/vscodium/releases/download/1.143.17232/VSCodium-win32-x64-1.143.17232.zip", "sha256": "a1090868af8ac0ac04c22d79fdd02246fa115a78daf38a741d8db06df1753c1d" }
      ],
      "build": [
        "grep -q '\"updateUrl\"' resources/app/product.json",
        "sed -i '/\"updateUrl\"/d' resources/app/product.json",
        "! grep -q '\"updateUrl\"' resources/app/product.json",
        "grep -q 'setAsDefaultProtocolClient(' resources/app/out/mainImpl.js",
        "sed -i -E 's/[A-Za-z0-9_$]+[.]setAsDefaultProtocolClient[(][^)]*[)]/void 0/' resources/app/out/mainImpl.js",
        "! grep -q 'setAsDefaultProtocolClient(' resources/app/out/mainImpl.js",
        "cp -r . \"$PREFIX/\""
      ]
    }
  ]
}
