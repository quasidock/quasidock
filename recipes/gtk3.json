{
  "id": "gtk3",
  "version": "3.24.52",
  "name": "GTK 3",
  "summary": "GTK 3 and ATK, with their typelibs, for GTK 3 apps, which have GTK 4's runtime too for GLib, Pango, cairo and the rest",
  "homepage": "https://www.gtk.org/",
  "license": "LGPL-2.1-or-later",
  "entrypoint": "about.bat",
  "path": ["bin"],
  "env": { "GSETTINGS_SCHEMA_DIR": "${app}\\share\\glib-2.0\\schemas", "XDG_DATA_DIRS": "${app}\\share" },
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/share/gir-1.0",
    "/share/aclocal",
    "/share/applications",
    "/share/gettext",
    "/share/gtk-3.0/valgrind",
    "/share/gtk-doc",
    "/share/man",
    "/share/pkgconfig",
    "*.a",
    "*.lib"
  ],
  "stages": [
    {
      "name": "gtk",
      "sources": [
        { "image": "gtk3-sdk:3.24.52@sha256:03d48cf8138d5d9b28d59a51b34b454d5ff8127abc4bd37e6407a2d15468fc37" }
      ]
    }
  ]
}
