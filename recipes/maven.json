{
  "id": "maven",
  "version": "3.10.0",
  "name": "Apache Maven",
  "summary": "Java's build tool and dependency manager, on OpenJDK; as an SDK, it gives builds a mvn command",
  "homepage": "https://maven.apache.org/",
  "license": "Apache-2.0",
  "entrypoint": [
    "${java}\\bin\\java.exe",
    "--enable-native-access=ALL-UNNAMED",
    "-classpath",
    "${app}\\boot\\plexus-classworlds-2.12.1.jar",
    "-Dclassworlds.conf=${app}\\bin\\m2.conf",
    "-Dmaven.home=${app}",
    "-Dlibrary.jline.path=${app}\\lib\\jline-native",
    "-Dorg.jline.terminal.exec.redirectPipeCreationMode=native,reflection",
    "-Dmaven.multiModuleProjectDirectory=.",
    "org.codehaus.plexus.classworlds.launcher.Launcher"
  ],
  "permissions": {
    "sandbox": "soft",
    "network": true,
    "filesystem": ["cwd"]
  },
  "from": { "java": "java-sdk:25.0.5_8@sha256:8febd72d8cddbf9ca931a3b95d4714dd190f86428adba1b70deffa2fcf81c23d" },
  "env": { "QUASIDOCK_MAVEN_JAVA": "${java}\\bin\\java.exe" },
  "path": ["sdk-bin", "."],
  "sdk": {
    "zig": "zig:0.17.0@sha256:56fc3e4f42c25dbf70236aedb053606311cb2d4b582ad4d1e26e76036c08eab1",
    "busybox": "busybox:FRP-6075-g169694ebd@sha256:baca1ecd27b7b5ffe54402d4f8b6e36802d9db5e0e4cb2b7ab13104031045c50"
  },
  "stages": [
    {
      "name": "maven",
      "sources": [
        { "url": "https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/3.10.0/apache-maven-3.10.0-bin.zip", "sha256": "1f6d9909266510f039f59aa0e13dcd2c66da85f043e56276e41f2918f8bddaff", "strip": 1 }
      ]
    },
    {
      "name": "sdk-commands",
      "sources": [
        { "path": "sdk-tools/launcher.c", "dest": "launcher.c" },
        { "path": "maven/commands.h", "dest": "commands.h" }
      ],
      "build": [
        "mkdir -p \"$PREFIX/sdk-bin\"",
        "cc.exe -O2 -municode -s -Wl,-Brepro launcher.c -o \"$PREFIX/sdk-bin/mvn.exe\""
      ]
    }
  ]
}
