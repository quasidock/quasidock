{
  "id": "gdal",
  "version": "3.13.3",
  "name": "GDAL",
  "summary": "GDAL's raster and vector tools (gdal, gdalinfo, gdal_translate, gdalwarp, ogr2ogr and the rest), built with Clang on GEOS, PROJ and SQLite",
  "homepage": "https://gdal.org/",
  "license": "MIT AND LGPL-2.1-or-later AND blessing AND Zlib AND libtiff AND IJG AND libpng-2.0 AND Apache-2.0 AND Qhull",
  "entrypoint": "bin/gdal.exe",
  "path": ["bin"],
  "env": { "GDAL_DATA": "${app}\\share\\gdal", "PROJ_DATA": "${app}\\share\\proj" },
  "permissions": {
    "filesystem": ["cwd"]
  },
  "sdk": { "gdalsdk": "gdal-sdk:3.13.3@sha256:974ff8f22b561da77ea2442b6bbcb0693eb07637be1152804af45d13fcada7da" },
  "cleanup": ["/include", "/lib", "/bin/gdal-config", "/bin/geos-config", "/bin/sqlite3.exe", "/bin/iconv.exe"],
  "stages": [
    {
      "name": "gdal",
      "sources": [
        { "image": "gdal-sdk:3.13.3@sha256:974ff8f22b561da77ea2442b6bbcb0693eb07637be1152804af45d13fcada7da" }
      ]
    }
  ]
}
