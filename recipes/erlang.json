{
  "id": "erlang",
  "version": "29.1.3",
  "name": "Erlang/OTP",
  "summary": "Erlang/OTP runtime, compiler and development tools from the official Windows distribution",
  "homepage": "https://www.erlang.org/",
  "license": "Apache-2.0",
  "entrypoint": "bin/erl.exe",
  "path": ["bin", "erts-17.1.2/bin"],
  "env": { "ERLANG_HOME": "${app}", "ERL_CRASH_DUMP": "${data}\\erl_crash.dump" },
  "permissions": { "filesystem": ["cwd"] },
  "sdk": {
    "llvm": "llvm-mingw:20261020@sha256:c4d0aa87912200ce510965071375618de13c4064fb433ea5b1b182b83cd79099",
    "python": "python:3.14.10@sha256:3d18034b1becc9bb3b4a36fd212662db33015bbb510b3cf78fd3776d6e9fa274",
    "busybox": "busybox:FRP-6075-g169694ebd@sha256:baca1ecd27b7b5ffe54402d4f8b6e36802d9db5e0e4cb2b7ab13104031045c50"
  },
  "cleanup": ["/doc", "/Install.exe", "/Install.ini", "erl.ini", "*.pdb", "beam.debug.*.dll"],
  "stages": [
    {
      "name": "otp",
      "sources": [
        { "url": "https://github.com/erlang/otp/releases/download/OTP-29.1.3/otp_win64_29.1.3.zip", "sha256": "b47fa07264ef4d2847d20c76568c240dfe0970f5d52099d9615d3a4f6a4482b2" }
      ]
    },
    {
      "name": "console-launcher",
      "sources": [
        { "path": "erlang/erl.c" },
        { "path": "erlang/patch-pipes.py" }
      ],
      "build": [
        "python.exe patch-pipes.py \"$PREFIX/erts-17.1.2/bin\"",
        "cc.exe -O2 -municode -s -Wl,--no-insert-timestamp erl.c -o \"$PREFIX/bin/erl.exe\"",
        "cp \"$PREFIX/bin/erl.exe\" \"$PREFIX/erts-17.1.2/bin/erl.exe\""
      ]
    }
  ]
}
