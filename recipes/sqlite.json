{
  "id": "sqlite",
  "version": "3.53.4",
  "name": "SQLite",
  "summary": "The SQLite database's command-line shell",
  "homepage": "https://sqlite.org/",
  "license": "blessing",
  "entrypoint": "bin/sqlite3.exe",
  "permissions": {
    "filesystem": ["cwd"]
  },
  "sdk": {
    "zig": "zig:0.17.0@sha256:d56d973884d07ce551d9697535f43d18183a3ce0ee3f79f0c9d40ce041842d5f",
    "busybox": "busybox:FRP-6075-g169694ebd@sha256:3d73278be5092691667ebeecd92ffe034fb6898221024e4859325fb379178d2a"
  },
  "cleanup": ["/include", "/lib"],
  "stages": [
    {
      "name": "zlib",
      "sources": [
        { "url": "https://github.com/madler/zlib/releases/download/v1.4/zlib-1.4.tar.xz", "sha256": "4f11c512053d7bab8d9e9b89bde3575add3e4c50a383b42ef6cb837035fc5a7c", "strip": 1 }
      ],
      "build": [
        "for f in *.c; do zig cc -target x86_64-windows-gnu -O2 -c \"$f\" -o \"${f%.c}.o\" || exit 1; done",
        "zig ar rcs libz.a *.o",
        "mkdir -p \"$PREFIX/include\" \"$PREFIX/lib\"",
        "cp zlib.h zconf.h \"$PREFIX/include\" && cp libz.a \"$PREFIX/lib\""
      ]
    },
    {
      "name": "sqlite",
      "sources": [
        { "url": "https://sqlite.org/2026/sqlite-amalgamation-3530400.zip", "sha256": "1e71ddf93849c6a6ecf58b827c0692073d2dd7ee40196158068f7b29f422e87d", "strip": 1 }
      ],
      "build": [
        "mkdir -p \"$PREFIX/bin\"",
        "zig cc -target x86_64-windows-gnu -O2 -s -DSQLITE_HAVE_ZLIB -I\"$PREFIX/include\" -o \"$PREFIX/bin/sqlite3.exe\" shell.c sqlite3.c \"$PREFIX/lib/libz.a\""
      ]
    }
  ]
}
