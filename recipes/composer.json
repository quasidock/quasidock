{
  "id": "composer",
  "version": "2.10.3",
  "name": "Composer",
  "summary": "Composer, the dependency manager for PHP, on PHP's runtime; as an SDK, it gives builds a composer command",
  "homepage": "https://getcomposer.org/",
  "license": "MIT",
  "entrypoint": ["${php}\\php.exe", "${app}\\composer.phar"],
  "permissions": {
    "network": true,
    "filesystem": ["cwd"]
  },
  "from": { "php": "php:8.5.12-1@sha256:12e0c8ba350be5cbc974ed42cf87358136479e8b8b5960e7ea9720643c445df5" },
  "env": { "QUASIDOCK_COMPOSER_PHP": "${php}\\php.exe" },
  "path": ["sdk-bin", "."],
  "sdk": {
    "zig": "zig:0.17.0@sha256:d56d973884d07ce551d9697535f43d18183a3ce0ee3f79f0c9d40ce041842d5f",
    "busybox": "busybox:FRP-6075-g169694ebd@sha256:3d73278be5092691667ebeecd92ffe034fb6898221024e4859325fb379178d2a"
  },
  "stages": [
    {
      "name": "composer",
      "sources": [
        { "url": "https://getcomposer.org/download/2.10.3/composer.phar", "sha256": "7a2d379d5b8ffdaa028580ef26494c36d2feef4b178d3dd1473a4dbc5e17c8d6", "dest": "composer.phar" }
      ]
    },
    {
      "name": "sdk-commands",
      "sources": [
        { "path": "sdk-tools/launcher.c", "dest": "launcher.c" },
        { "path": "composer/commands.h", "dest": "commands.h" }
      ],
      "build": [
        "mkdir -p \"$PREFIX/sdk-bin\"",
        "cc.exe -O2 -municode -s -Wl,-Brepro launcher.c -o \"$PREFIX/sdk-bin/composer.exe\""
      ]
    }
  ]
}
