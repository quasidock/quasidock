{
  "id": "postgresql",
  "version": "18.6",
  "name": "PostgreSQL",
  "summary": "The PostgreSQL database server and its client programs, built with Clang (llvm-mingw), with PL/Perl and PL/Python",
  "homepage": "https://www.postgresql.org/",
  "license": "PostgreSQL",
  "entrypoint": "bin/pg-server.exe",
  "path": ["bin"],
  "env": {
    "PGDATA": "${data}\\data",
    "PGPASSFILE": "${data}\\pgpass.conf",
    "PGUSER": "postgres",
    "PGHOST": "localhost",
    "PGPORT": "${listen:postgresql}",
    "SSL_CERT_FILE": "${roots}"
  },
  "permissions": {
    "network": true,
    "services": [
      { "name": "postgresql", "port": 5432, "command": "bin/pg-server.exe" }
    ]
  },
  "sdk": { "pgsdk": "postgresql-sdk:18.6@sha256:78844dc4dd9e47cc326e0a56fe216d7fe207ee6cbda16dabb7ba1ad510e7ac12" },
  "from": {
    "perl": "perl:5.42.3.1@sha256:f5c9f71d4c4867cd2c91100b2de48a95c3e2f6f17b12454d39feea99e6daa178",
    "python": "python:3.14.10@sha256:887cfcc7cad5bd8c423efd6087c7ef5f02906791ba2780b6030f789534679e72"
  },
  "cleanup": [
    "/include",
    "/lib/cmake",
    "/lib/pkgconfig",
    "*.a",
    "/share/doc",
    "/share/man",
    "/bin/xml2-config",
    "/bin/xmllint.exe",
    "/bin/xmlcatalog.exe",
    "/bin/test_cloexec.exe",
    "/lib/postgresql/pgxs"
  ],
  "stages": [
    {
      "name": "postgresql",
      "sources": [
        { "image": "postgresql-sdk:18.6@sha256:78844dc4dd9e47cc326e0a56fe216d7fe207ee6cbda16dabb7ba1ad510e7ac12" }
      ]
    }
  ]
}
