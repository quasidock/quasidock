{
  "id": "postgresql",
  "version": "18.6",
  "name": "PostgreSQL",
  "summary": "The PostgreSQL database server and its client programs, built with Clang (llvm-mingw), with PL/Perl and PL/Python",
  "homepage": "https://www.postgresql.org/",
  "license": "PostgreSQL",
  "entrypoint": "bin/pg-server.exe",
  "path": ["bin"],
  "env": {
    "PGDATA": "${data}\\data",
    "PGPASSFILE": "${data}\\pgpass.conf",
    "PGUSER": "postgres",
    "PGHOST": "localhost",
    "PGPORT": "${listen:postgresql}",
    "SSL_CERT_FILE": "${roots}"
  },
  "permissions": {
    "network": true,
    "services": [
      { "name": "postgresql", "port": 5432, "command": "bin/pg-server.exe" }
    ]
  },
  "sdk": { "pgsdk": "postgresql-sdk:18.6@sha256:1026b6edae04ffd2eaed19bdd96933db131857bd3fd5843c5d3735a41160b646" },
  "from": {
    "perl": "perl:5.42.3.1@sha256:4bf63dc4d73c1094335f85767629736c3d01276dc3e46be04bfba985b70e25df",
    "python": "python:3.14.10@sha256:ccd0d0e3ef77fd28cfa787f19405ffe747d47f1483312df00819dce1a356c5b4"
  },
  "cleanup": [
    "/include",
    "/lib/cmake",
    "/lib/pkgconfig",
    "*.a",
    "/share/doc",
    "/share/man",
    "/bin/xml2-config",
    "/bin/xmllint.exe",
    "/bin/xmlcatalog.exe",
    "/bin/test_cloexec.exe",
    "/lib/postgresql/pgxs"
  ],
  "stages": [
    {
      "name": "postgresql",
      "sources": [
        { "image": "postgresql-sdk:18.6@sha256:1026b6edae04ffd2eaed19bdd96933db131857bd3fd5843c5d3735a41160b646" }
      ]
    }
  ]
}
