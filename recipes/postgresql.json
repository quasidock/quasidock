{
  "id": "postgresql",
  "version": "18.6",
  "name": "PostgreSQL",
  "summary": "The PostgreSQL database server and its client programs, built with Clang (llvm-mingw), with PL/Perl and PL/Python",
  "homepage": "https://www.postgresql.org/",
  "license": "PostgreSQL",
  "entrypoint": "bin/pg-server.exe",
  "path": ["bin"],
  "env": {
    "PGDATA": "${data}\\data",
    "PGPASSFILE": "${data}\\pgpass.conf",
    "PGUSER": "postgres",
    "PGHOST": "localhost",
    "PGPORT": "${listen:postgresql}",
    "SSL_CERT_FILE": "${roots}"
  },
  "permissions": {
    "network": true,
    "services": [
      { "name": "postgresql", "port": 5432, "command": "bin/pg-server.exe" }
    ]
  },
  "sdk": { "pgsdk": "postgresql-sdk:18.6@sha256:78844dc4dd9e47cc326e0a56fe216d7fe207ee6cbda16dabb7ba1ad510e7ac12" },
  "from": {
    "perl": "perl:5.42.3.1@sha256:2854c34722b812ef3173f5d4ab6fb091ac45dc16d6079865a5024d6a6527dfd6",
    "python": "python:3.14.10@sha256:6c21dc182028bd8bf86a9b13969425eceb7701c611e13c74c73491c5a9509605"
  },
  "cleanup": [
    "/include",
    "/lib/cmake",
    "/lib/pkgconfig",
    "*.a",
    "/share/doc",
    "/share/man",
    "/bin/xml2-config",
    "/bin/xmllint.exe",
    "/bin/xmlcatalog.exe",
    "/bin/test_cloexec.exe",
    "/lib/postgresql/pgxs"
  ],
  "stages": [
    {
      "name": "postgresql",
      "sources": [
        { "image": "postgresql-sdk:18.6@sha256:78844dc4dd9e47cc326e0a56fe216d7fe207ee6cbda16dabb7ba1ad510e7ac12" }
      ]
    }
  ]
}
