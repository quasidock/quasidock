{
  "id": "java-sdk",
  "version": "25.0.5_8",
  "name": "OpenJDK",
  "summary": "Java's development kit, Eclipse Temurin's build of OpenJDK 25: java, javac, jar, jshell, jlink and the rest",
  "homepage": "https://adoptium.net/",
  "license": "GPL-2.0-only WITH Classpath-exception-2.0",
  "entrypoint": "bin/java.exe",
  "path": ["bin"],
  "env": {
    "JAVA_HOME": "${app}",
    "JAVA_TOOL_OPTIONS": "\"-Duser.home=${data}\\home\" -Dsun.font.layout.ffm=false -Djavax.net.ssl.trustStoreType=Windows-ROOT-LOCALMACHINE"
  },
  "permissions": {
    "sandbox": "soft",
    "network": true,
    "filesystem": ["cwd"]
  },
  "cleanup": ["/lib/src.zip"],
  "stages": [
    {
      "name": "jdk",
      "sources": [
        { "url": "https://github.com/adoptium/temurin25-binaries/releases/download/jdk-25.0.5%2B8/OpenJDK25U-jdk_x64_windows_hotspot_25.0.5_8.zip", "sha256": "636bdc13dc649ddc7d5921c5c7d23cca6e44fd19d662b45cc9c02135a6c96c42", "strip": 1 }
      ]
    }
  ]
}
