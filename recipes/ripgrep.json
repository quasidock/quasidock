{
  "id": "ripgrep",
  "version": "15.2.0",
  "name": "ripgrep",
  "summary": "Searches files for a regular expression, recursively and fast, respecting .gitignore",
  "homepage": "https://github.com/BurntSushi/ripgrep",
  "license": "Unlicense OR MIT",
  "entrypoint": "rg.exe",
  "permissions": {
    "filesystem": ["cwd:ro"]
  },
  "sdk": {
    "rust": "rust:1.99.0@sha256:62344d25e7c11b393e6094386eca31bc4f8f0bdbe45845fc61fe58700f112f8d",
    "zig": "zig:0.17.0@sha256:56fc3e4f42c25dbf70236aedb053606311cb2d4b582ad4d1e26e76036c08eab1",
    "busybox": "busybox:FRP-6075-g169694ebd@sha256:baca1ecd27b7b5ffe54402d4f8b6e36802d9db5e0e4cb2b7ab13104031045c50"
  },
  "stages": [
    {
      "name": "ripgrep",
      "sources": [
        { "url": "https://static.crates.io/crates/ripgrep/ripgrep-15.2.0.crate", "sha256": "a30750b6d0743bfdd2656ebbaf4555aa278c43144b84bc389bcbfa399485ec71", "strip": 1 }
      ],
      "vendor": {
        "commands": ["cargo vendor --locked vendor >/dev/null"],
        "dir": "vendor",
        "sha256": "11be11f3b4b931f09d3b4b4da2a0f0437dda2a1349e45ff944d38098d9d7f5f3"
      },
      "build": [
        "cargo build --offline --locked --profile release-lto --config 'source.crates-io.replace-with=\"vendored\"' --config 'source.vendored.directory=\"vendor\"'",
        "mkdir -p \"$PREFIX/doc\" \"$PREFIX/complete\"",
        "cp target/release-lto/rg.exe README.md COPYING LICENSE-MIT UNLICENSE \"$PREFIX/\"",
        "cp CHANGELOG.md FAQ.md GUIDE.md \"$PREFIX/doc/\"",
        "target/release-lto/rg.exe --generate man > \"$PREFIX/doc/rg.1\"",
        "for shell in bash:rg.bash fish:rg.fish zsh:_rg powershell:_rg.ps1; do target/release-lto/rg.exe --generate complete-${shell%%:*} > \"$PREFIX/complete/${shell#*:}\" || exit 1; done"
      ]
    }
  ]
}
