{
  "id": "gtk4",
  "version": "4.24.1",
  "name": "GTK",
  "summary": "GTK 4, libadwaita and the stack below them, with their typelibs, for apps built with GTK's SDK",
  "homepage": "https://www.gtk.org/",
  "license": "LGPL-2.1-or-later",
  "entrypoint": "bin/gtk4-demo.exe",
  "path": ["bin"],
  "env": {
    "XDG_CONFIG_HOME": "${data}\\config",
    "XDG_DATA_HOME": "${data}\\share",
    "XDG_STATE_HOME": "${data}\\state",
    "XDG_CACHE_HOME": "${data}\\cache",
    "XDG_DATA_DIRS": "${app}\\share",
    "GSETTINGS_BACKEND": "keyfile"
  },
  "permissions": {
    "filesystem": ["cwd"]
  },
  "sdk": { "gtksdk": "gtk4-sdk:4.24.1@sha256:e79afa3f16a0fcf7a6a38a2bd48a705ee1ea711c419d3e9290e4be027ab2c04c" },
  "cleanup": [
    "/include",
    "/lib/cmake",
    "/lib/glib-2.0",
    "/lib/graphene-1.0",
    "/lib/libpng",
    "/lib/libpng.dll",
    "/lib/pkgconfig",
    "*.a",
    "*.la",
    "*.lib",
    "/share/thumbnailers",
    "/bin/psl-make-dafsa",
    "xmlcatalog.exe",
    "xmllint.exe",
    "rsvg-convert.exe",
    "/share/applications",
    "/share/metainfo",
    "/share/pkgconfig",
    "/share/aclocal",
    "/share/bash-completion",
    "/share/gettext",
    "/share/man",
    "/share/doc/libjpeg-turbo/example.c",
    "/share/doc/libjpeg-turbo/tjcomp.c",
    "/share/doc/libjpeg-turbo/tjdecomp.c",
    "/share/glib-2.0/codegen",
    "/share/glib-2.0/gdb",
    "/share/gtk-4.0/gtk4builder.rng",
    "/bin/gdbus-codegen",
    "/bin/glib-genmarshal",
    "/bin/glib-mkenums",
    "/bin/gtester-report",
    "*-config",
    "cjpeg.exe",
    "djpeg.exe",
    "jpegtran.exe",
    "rdjpgcom.exe",
    "wrjpgcom.exe",
    "gi-*.exe",
    "libgirepository-1.0-*",
    "/python",
    "/lib/gobject-introspection",
    "/share/gir-1.0",
    "/share/gobject-introspection-1.0",
    "/bin/g-ir-*",
    "msg*.exe",
    "xgettext.exe",
    "envsubst.exe",
    "gettext.exe",
    "ngettext.exe",
    "printf_gettext.exe",
    "printf_ngettext.exe",
    "recode-sr-latin.exe",
    "iconv.exe",
    "/bin/autopoint",
    "/bin/gettextize",
    "/bin/gettext.sh",
    "/bin/po-fetch",
    "/bin/spit",
    "libgettextlib-*",
    "libgettextsrc-*",
    "libgettextpo-*",
    "libtextstyle-*",
    "/libexec",
    "/share/gettext-1.0",
    "/share/info",
    "/share/doc/gettext",
    "/share/doc/libtextstyle",
    "/share/doc/libiconv",
    "gettext-runtime.mo",
    "gettext-tools.mo"
  ],
  "stages": [
    {
      "name": "gtk",
      "sources": [
        { "image": "gtk4-sdk:4.24.1@sha256:e79afa3f16a0fcf7a6a38a2bd48a705ee1ea711c419d3e9290e4be027ab2c04c" }
      ]
    },
    {
      "name": "icons",
      "sources": [
        { "path": "gtk4-sdk/svg2ico.sh" }
      ],
      "build": [
        "for app in org.gtk.Demo4 org.gtk.WidgetFactory4 org.gnome.Adwaita1.Demo; do sh svg2ico.sh \"$PREFIX/share/icons/hicolor/scalable/apps/$app.svg\" \"$PREFIX/share/icons/$app.ico\" || exit 1; done"
      ]
    }
  ]
}
