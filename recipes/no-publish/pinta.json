{
  "id": "pinta",
  "version": "3.1.2",
  "name": "Pinta",
  "summary": "Edit images and paint digitally",
  "homepage": "https://www.pinta-project.com/",
  "license": "MIT",
  "entrypoint": "bin/Pinta.exe",
  "path": ["bin"],
  "env": { "XDG_DATA_DIRS": "${app}\\share" },
  "permissions": {
    "filesystem": ["cwd"]
  },
  "from": {
    "dotnet": "dotnet:10.0.13@sha256:a9e05a1fe615515ed8e890187690c9bfc55193305cc103b4a340a8782b5a9c0a",
    "gtk": "gtk4:4.24.1@sha256:ce922465155eb14a4573d1d99fee58893759a736e2b8eaee35f58322c5490317"
  },
  "sdk": {
    "dotnetsdk": "dotnet-sdk:10.0.402@sha256:7687b4c6ce4f2fc43cf123426b5cf31fbe1b253978281ce56fe4fa36b1b28240",
    "gettext": "gettext:1.0@sha256:92b9c82ba4fb6e9a2b679050ce1dd7ef22ce43131441559e0a8fe0953d167ed1",
    "busybox": "busybox:FRP-6075-g169694ebd@sha256:db9d39727bfdd4d176b5878c0a125daa8a2396ea21e0f01a6a372f53d9d97e5d"
  },
  "cleanup": ["*.pdb"],
  "stages": [
    {
      "name": "pinta",
      "sources": [
        { "url": "https://github.com/PintaProject/Pinta/releases/download/3.1.2/pinta-3.1.2.tar.gz", "sha256": "27f55a026b51f6f18197e6bcfdd7c79544e41529d166daf6c93a1117e9ed45f0", "strip": 1 }
      ],
      "env": { "TargetFramework": "net10.0" },
      "vendor": {
        "commands": ["dotnet restore Pinta/Pinta.csproj --packages vendor"],
        "dir": "vendor",
        "sha256": "e93c0bd7adac517e6415fb92c1ba0891cd47de11309006eee8b78010c5046a28"
      },
      "build": [
        "sed -i '/installer\\/windows\\/bundle_gtk.targets/d' Pinta/Pinta.csproj",
        "! grep -q bundle_gtk Pinta/Pinta.csproj",
        "dotnet publish Pinta/Pinta.csproj -c Release -p:BuildTranslations=true --packages vendor --source \"$PWD/vendor\" -o \"$PREFIX/bin\"",
        "mkdir -p \"$PREFIX/share\" && mv \"$PREFIX/bin/icons\" \"$PREFIX/bin/locale\" \"$PREFIX/share/\""
      ]
    }
  ]
}
