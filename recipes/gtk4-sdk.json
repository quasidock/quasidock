{
  "id": "gtk4-sdk",
  "version": "4.24.1",
  "name": "GTK SDK",
  "summary": "GTK 4, libadwaita and the stack below them, with headers, import libraries, introspection data and the tools to build GTK apps with llvm-mingw's Clang",
  "homepage": "https://www.gtk.org/",
  "license": "LGPL-2.1-or-later",
  "entrypoint": "bin/gtk4-demo.exe",
  "path": ["bin"],
  "env": { "PKG_CONFIG_PATH": "${app}\\lib\\pkgconfig;${app}\\share\\pkgconfig", "RCFLAGS": "--use-temp-file" },
  "permissions": {
    "sandbox": "soft",
    "filesystem": ["cwd"]
  },
  "cleanup": ["__pycache__"],
  "sdk": {
    "cmake": "cmake:4.4.4@sha256:b96b30bb57b5147726b7deef2607917b43972bb896d9f5d3e3082e31368dbeae",
    "perl": "perl:5.42.3.1@sha256:2854c34722b812ef3173f5d4ab6fb091ac45dc16d6079865a5024d6a6527dfd6",
    "rust": "rust:1.99.0@sha256:62344d25e7c11b393e6094386eca31bc4f8f0bdbe45845fc61fe58700f112f8d",
    "cargo-c": "cargo-c:0.10.25@sha256:796088c5e02aef272bea1df667952836d49f71df3ef39dad1f58749ae5822222"
  },
  "from": {
    "meson": "meson:1.12.1@sha256:9b656a460928dbde77dc31f5827e9b99ad4b53e007de87b19b6fbec26785bbc3",
    "llvm": "llvm-mingw:20261020@sha256:65425754b958693accc5dc8d8e8ca0dfa6235669c286cc8875105171b3e299b9",
    "busybox": "busybox:FRP-6075-g169694ebd@sha256:baca1ecd27b7b5ffe54402d4f8b6e36802d9db5e0e4cb2b7ab13104031045c50"
  },
  "stages": [
    {
      "name": "base",
      "sources": [
        { "image": "gtk4-sdk-base:4.24.1@sha256:542f0ad46f32f30faac897d9d34d0ca6300490b371843cae81dc790ae6e283f6" }
      ]
    },
    {
      "name": "hicolor-icon-theme",
      "sources": [
        { "url": "https://icon-theme.freedesktop.org/releases/hicolor-icon-theme-0.18.tar.xz", "sha256": "db0e50a80aa3bf64bb45cbca5cf9f75efd9348cf2ac690b907435238c3cf81d7", "strip": 1 }
      ],
      "build": ["meson setup out --prefix=\"$PREFIX\"", "meson install -C out"]
    },
    {
      "name": "adwaita-icon-theme",
      "sources": [
        { "url": "https://download.gnome.org/sources/adwaita-icon-theme/51/adwaita-icon-theme-51.0.tar.xz", "sha256": "ba561cf3c96305a47179fa5605856ad695c9238ea07f7093aebd9ba80c4e323b", "strip": 1 }
      ],
      "build": ["meson setup out --prefix=\"$PREFIX\"", "meson install -C out"]
    },
    {
      "name": "libadwaita",
      "sources": [
        { "url": "https://download.gnome.org/sources/libadwaita/1.10/libadwaita-1.10.0.tar.xz", "sha256": "b1bf56239269d101a6391ad4553c910eff9cc6170b803916405477ef60a66c84", "strip": 1 }
      ],
      "build": [
        "sed -i -e 's/i18n[.]merge_file(/configure_file(copy: true,/' -e '/^ *po_dir:/d' -e '/^ *type:/d' demo/data/meson.build",
        "! grep -q merge_file demo/data/meson.build",
        "sed -i \"s/^demo_kwargs = {}$/demo_kwargs = { 'win_subsystem': 'windows' }/\" demo/meson.build",
        "grep -q \"^demo_kwargs = { 'win_subsystem': 'windows' }$\" demo/meson.build",
        "meson setup out --prefix=\"$PREFIX\" --buildtype=release -Dintrospection=enabled -Dvapi=false -Ddocumentation=false -Dtests=false -Dexamples=true",
        "meson install -C out"
      ]
    },
    {
      "name": "openssl",
      "env": { "CFLAGS": "-O2", "PREFIX": "B:/prefix", "PERL": "perl", "PERL5OPT": "-IB:/src/openssl/quasidock -Munixspec" },
      "sources": [
        { "url": "https://github.com/openssl/openssl/releases/download/openssl-3.5.9/openssl-3.5.9.tar.gz", "sha256": "603f5602e2eef00d77fbd429d34dcd5822bb301757a1bc9cdb24c670f1eb859a", "strip": 1 },
        { "path": "gtk4-sdk/openssl-unixspec.pm", "dest": "quasidock/unixspec.pm" }
      ],
      "build": [
        "perl Configure mingw64 no-shared no-asm no-tests no-docs no-apps no-module --prefix=\"$PREFIX\" --libdir=lib",
        "make build_generated $(sed -n '/^GENERATED=/,/[^\\\\]$/p' Makefile | tr ' ' '\\n' | grep '[.][ch]$')",
        "make -n build_libs | grep -e ' -c -o ' | tr '\\n' '\\0' | xargs -0 -P \"$(nproc)\" -n 1 sh -c",
        "make build_sw",
        "make install_dev",
        "sed -i -e 's/^Libs: -L${libdir} -lcrypto$/Libs: -L${libdir} -lcrypto -lws2_32 -lgdi32 -lcrypt32/' -e '/^Libs.private: /d' \"$PREFIX/lib/pkgconfig/libcrypto.pc\"",
        "grep -qx 'Libs: -L${libdir} -lcrypto -lws2_32 -lgdi32 -lcrypt32' \"$PREFIX/lib/pkgconfig/libcrypto.pc\""
      ]
    },
    {
      "name": "sqlite",
      "sources": [
        { "url": "https://sqlite.org/2026/sqlite-amalgamation-3530400.zip", "sha256": "1e71ddf93849c6a6ecf58b827c0692073d2dd7ee40196158068f7b29f422e87d", "strip": 1 },
        { "url": "https://wrapdb.mesonbuild.com/v2/sqlite3_3.53.4-1/get_patch", "sha256": "fe8033e209d350fa74e52ce1398253b373e7cfdd6809bc9f304e409e76f108af", "type": "zip", "strip": 1 }
      ],
      "build": ["meson setup out --prefix=\"$PREFIX\" --buildtype=release", "meson install -C out"]
    },
    {
      "name": "nghttp2",
      "sources": [
        { "url": "https://github.com/nghttp2/nghttp2/releases/download/v1.71.0/nghttp2-1.71.0.tar.xz", "sha256": "c0f55121d88650e4b9227aec28cebaf664d2417ca60fe70be0f8d38829f52116", "strip": 1 }
      ],
      "build": [
        "cmake -S . -B out -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=\"$PREFIX\" -DENABLE_LIB_ONLY=ON -DBUILD_SHARED_LIBS=ON -DBUILD_STATIC_LIBS=OFF -DENABLE_DOC=OFF -DBUILD_TESTING=OFF",
        "cmake --build out",
        "cmake --install out"
      ]
    },
    {
      "name": "libpsl",
      "sources": [
        { "url": "https://github.com/rockdaboot/libpsl/releases/download/0.23.3/libpsl-0.23.3.tar.gz", "sha256": "93941f85a1e7bd593fa94f299233cb5dfc91cd144fd9a78a6ceb75001c5b03be", "strip": 1 }
      ],
      "build": [
        "meson setup out --prefix=\"$PREFIX\" --buildtype=release -Druntime=no -Dbuiltin=true -Dtests=false -Ddocs=false",
        "meson install -C out"
      ]
    },
    {
      "name": "glib-networking",
      "sources": [
        { "url": "https://download.gnome.org/sources/glib-networking/2.90/glib-networking-2.90.1.tar.xz", "sha256": "ea95636590098355a05e3027579dba1a9a950b05e456b2488ea03d82e4b6c18a", "strip": 1 }
      ],
      "build": [
        "sed -i 's/CertOpenSystemStoreW (0, source_cert_store_name)/CertOpenStore (CERT_STORE_PROV_SYSTEM_W, 0, 0, CERT_SYSTEM_STORE_CURRENT_USER | CERT_STORE_READONLY_FLAG, source_cert_store_name)/' tls/openssl/gtlsdatabase-openssl.c",
        "grep -q CERT_STORE_READONLY_FLAG tls/openssl/gtlsdatabase-openssl.c",
        "meson setup out --prefix=\"$PREFIX\" --buildtype=release -Dgnutls=disabled -Dopenssl=enabled -Dlibproxy=disabled -Dgnome_proxy=disabled -Denvironment_proxy=enabled -Dtests=false",
        "meson install -C out"
      ]
    },
    {
      "name": "libsoup",
      "sources": [
        { "url": "https://download.gnome.org/sources/libsoup/3.8/libsoup-3.8.1.tar.xz", "sha256": "5013dcef9136f6f861e6529fca578af50c1f52a39219027fb5aff652d1371a04", "strip": 1 }
      ],
      "build": [
        "meson setup out --prefix=\"$PREFIX\" --buildtype=release -Dtls_check=false -Dgssapi=disabled -Dntlm=disabled -Dbrotli=disabled -Dzstd=disabled -Dintrospection=enabled -Dvapi=disabled -Ddocs=disabled -Ddoc_tests=false -Dtests=false -Dautobahn=disabled -Dsysprof=disabled -Dpkcs11_tests=disabled",
        "meson install -C out"
      ]
    },
    {
      "name": "freetype",
      "sources": [
        { "url": "https://downloads.sourceforge.net/project/freetype/freetype2/2.15.0/freetype-2.15.0.tar.xz", "sha256": "93cd47eb719c325107f2d3cf087d06299e944c3b48a40b55537302304dea1dd5", "strip": 1 }
      ],
      "build": [
        "meson setup out --prefix=\"$PREFIX\" --buildtype=release -Dbrotli=disabled -Dbzip2=disabled -Dharfbuzz=disabled -Dpng=disabled -Dzlib=disabled -Dtests=disabled",
        "meson install -C out"
      ]
    },
    {
      "name": "libxml2",
      "sources": [
        { "url": "https://download.gnome.org/sources/libxml2/2.15/libxml2-2.15.4.tar.xz", "sha256": "98087fd181d9070724f3fbc65c7377db03038eb92bd882374daff44940138821", "strip": 1 }
      ],
      "build": [
        "sed -i \"/^r = run_command('git', 'describe', check: false)$/,/^endif$/d\" meson.build",
        "! grep -q \"run_command('git'\" meson.build",
        "meson setup out --prefix=\"$PREFIX\" --buildtype=release -Ddocs=disabled -Dpython=disabled -Dhttp=disabled -Dicu=disabled -Diconv=disabled -Dreadline=disabled -Dhistory=disabled -Dzlib=disabled",
        "meson install -C out"
      ]
    },
    {
      "name": "librsvg",
      "env": { "PYTHONHASHSEED": "0" },
      "sources": [
        { "url": "https://download.gnome.org/sources/librsvg/2.63/librsvg-2.63.4.tar.xz", "sha256": "31f07d9350dad3f8964fd613c31309ac160fdef13dfac59df6fd082de78d6e8f", "strip": 1 }
      ],
      "vendor": {
        "commands": ["cargo vendor --locked vendor >/dev/null"],
        "dir": "vendor",
        "sha256": "33f8df190034ad563f52cdbd4834cef3d655a3657c52f89e14c91225cc1cfe0a"
      },
      "build": [
        "mkdir -p .cargo && printf '%s\\n' '[source.crates-io]' 'replace-with = \"vendored\"' '[source.vendored]' 'directory = \"vendor\"' '[net]' 'offline = true' > .cargo/config.toml",
        "sed -i -e \"s/^    nm = find_program('nm')$/    nm = find_program('nm', required: false, disabler: true)/\" -e '/^    link_depends: librsvg_ver,$/d' rsvg/meson.build",
        "grep -q \"find_program('nm', required: false, disabler: true)\" rsvg/meson.build && ! grep -q 'link_depends: librsvg_ver' rsvg/meson.build",
        "sed -i 's/^    link_whole: librsvg_c_lib,$/    link_with: librsvg_c_lib,/' rsvg/meson.build",
        "grep -q '^    link_with: librsvg_c_lib,$' rsvg/meson.build",
        "export CARGO_TARGET_X86_64_PC_WINDOWS_GNU_LINKER=\"$(rustc --print sysroot)/lib/rustlib/x86_64-pc-windows-gnu/bin/self-contained/x86_64-w64-mingw32-gcc.exe\" && meson setup out --prefix=\"$PREFIX\" --buildtype=release -Dtriplet=x86_64-pc-windows-gnu -Dpixbuf=enabled -Dpixbuf-loader=enabled -Drsvg-convert=enabled -Dintrospection=enabled -Dvala=disabled -Ddocs=disabled -Dtests=false -Davif=disabled",
        "export CARGO_TARGET_X86_64_PC_WINDOWS_GNU_LINKER=\"$(rustc --print sysroot)/lib/rustlib/x86_64-pc-windows-gnu/bin/self-contained/x86_64-w64-mingw32-gcc.exe\" && meson install -C out",
        "grep -q 'pixbufloader_svg[.]dll' \"$PREFIX/lib/gdk-pixbuf-2.0/2.10.0/loaders.cache\" && ! grep -q '^\"B:' \"$PREFIX/lib/gdk-pixbuf-2.0/2.10.0/loaders.cache\""
      ]
    },
    {
      "name": "hunspell",
      "env": {
        "SED": "sed",
        "GREP": "grep",
        "EGREP": "grep -E",
        "FGREP": "grep -F",
        "AWK": "awk",
        "AR": "ar.exe",
        "RANLIB": "ranlib.exe",
        "CFLAGS": "-O2",
        "CXXFLAGS": "-O2"
      },
      "sources": [
        { "url": "https://github.com/hunspell/hunspell/releases/download/v1.7.6/hunspell-1.7.6.tar.gz", "sha256": "9c650ace31d4d8cc1da925a9507c3de1d50f1a54857af2f72429f517d5d53467", "strip": 1 },
        { "path": "gtk4-sdk/autotools-mtimes.sh", "dest": "quasidock/mtimes.sh" }
      ],
      "build": [
        "sh quasidock/mtimes.sh",
        "sh ./configure --build=x86_64-w64-mingw32 --host=x86_64-w64-mingw32 --prefix=\"$PREFIX\" --disable-static --disable-nls --without-ui --without-readline lt_cv_deplibs_check_method=pass_all > configure.log 2>&1 || { tail -60 config.log; exit 1; }",
        "sed -i 's/ -shared -nostdlib / -shared /' libtool",
        "make -C src/hunspell -j\"$(nproc)\"",
        "make -C src/hunspell install",
        "make install-pkgconfDATA"
      ]
    },
    {
      "name": "enchant",
      "env": {
        "SED": "sed",
        "GREP": "grep",
        "EGREP": "grep -E",
        "FGREP": "grep -F",
        "AWK": "awk",
        "AR": "ar.exe",
        "RANLIB": "ranlib.exe",
        "NM": "nm",
        "RM": "rm -f",
        "CFLAGS": "-O2",
        "CXXFLAGS": "-O2",
        "PKG_CONFIG": "pkg-config",
        "DOXYGEN": "true"
      },
      "sources": [
        { "url": "https://github.com/rrthomas/enchant/releases/download/v2.8.21/enchant-2.8.21.tar.gz", "sha256": "dd2a762697c463148a8f59867089a5ebf2dd1449d869f93764b76c12bcf8acc0", "strip": 1 },
        { "path": "gtk4-sdk/autotools-mtimes.sh", "dest": "quasidock/mtimes.sh" },
        { "path": "gtk4-sdk/enchant.ordering", "dest": "quasidock/enchant.ordering" }
      ],
      "build": [
        "sh quasidock/mtimes.sh",
        "sh ./configure --build=x86_64-w64-mingw32 --host=x86_64-w64-mingw32 --prefix=\"$PREFIX\" --disable-static --enable-relocatable --disable-gcc-warnings --with-hunspell --with-winspell --without-aspell --without-nuspell --without-hspell --without-voikko --without-applespell --without-zemberek lt_cv_deplibs_check_method=pass_all > configure.log 2>&1 || { tail -60 config.log; exit 1; }",
        "grep -q '^#define ENABLE_RELOCATABLE 1' config.h && grep -q '^HUNSPELL_LIBS = .*hunspell' providers/Makefile && grep -q '^WINSPELL_CFLAGS = ..' providers/Makefile",
        "sed -i 's/ -shared -nostdlib / -shared /' libtool",
        "printf '%s\\n' EXPORTS init_enchant_provider > quasidock/provider.def",
        "make -C libgnu -j\"$(nproc)\"",
        "sed -i 's/^nodist_doc_DATA = enchant.html$/nodist_doc_DATA =/' lib/Makefile && ! grep -q '^nodist_doc_DATA = .' lib/Makefile",
        "make -C lib -j\"$(nproc)\"",
        "grep -q '^ *enchant_broker_init' lib/.libs/libenchant-2-2.dll.def && ! grep -v -e '^EXPORTS' -e '^ *enchant_' lib/.libs/libenchant-2-2.dll.def | grep -q .",
        "make -C providers -j\"$(nproc)\" LDFLAGS=\"$LDFLAGS -export-symbols B:/src/enchant/quasidock/provider.def\"",
        "make -C lib install",
        "make -C providers install",
        "make install-pkgconfigDATA",
        "cp quasidock/enchant.ordering \"$PREFIX/share/enchant-2/enchant.ordering\""
      ]
    },
    {
      "name": "hunspell-en-us",
      "sources": [
        { "url": "https://raw.githubusercontent.com/LibreOffice/dictionaries/e7f163feb2beaf526135132d8716e68e19d2716e/en/en_US.aff", "sha256": "e746c882dd6f303c2c46e7452804b9201115a6942cfeb15f18f8edf774d2e24e", "dest": "share/hunspell/en_US.aff" },
        { "url": "https://raw.githubusercontent.com/LibreOffice/dictionaries/e7f163feb2beaf526135132d8716e68e19d2716e/en/en_US.dic", "sha256": "f0b1a234bd178bdd01875b2a392a9647f888b8fe879f79c52aae62c2759b3647", "dest": "share/hunspell/en_US.dic" },
        { "url": "https://raw.githubusercontent.com/LibreOffice/dictionaries/e7f163feb2beaf526135132d8716e68e19d2716e/en/README_en_US.txt", "sha256": "168b4c01cb841f766a72f310b065c04d09cff46376c37a81d799593ce751c371", "dest": "share/doc/hunspell-en-us/README_en_US.txt" }
      ],
      "build": ["mkdir -p \"$PREFIX/share/hunspell\" \"$PREFIX/share/doc/hunspell-en-us\"", "cp -r share \"$PREFIX/\""]
    }
  ]
}
