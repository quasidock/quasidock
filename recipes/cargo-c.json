{
  "id": "cargo-c",
  "version": "0.10.25",
  "entrypoint": "bin/cargo-cbuild.exe",
  "path": ["bin"],
  "permissions": {
    "sandbox": "soft",
    "filesystem": ["cwd"]
  },
  "sdk": {
    "rust": "rust:1.99.0@sha256:62344d25e7c11b393e6094386eca31bc4f8f0bdbe45845fc61fe58700f112f8d",
    "zig": "zig:0.17.0@sha256:56fc3e4f42c25dbf70236aedb053606311cb2d4b582ad4d1e26e76036c08eab1",
    "busybox": "busybox:FRP-6075-g169694ebd@sha256:baca1ecd27b7b5ffe54402d4f8b6e36802d9db5e0e4cb2b7ab13104031045c50"
  },
  "stages": [
    {
      "name": "cargo-c",
      "env": { "CFLAGS_x86_64_pc_windows_gnu": "-O3 -ffunction-sections -fdata-sections -D__MSVCRT_VERSION__=0x700" },
      "sources": [
        { "url": "https://static.crates.io/crates/cargo-c/cargo-c-0.10.25%2Bcargo-0.99.0.crate", "sha256": "6b2ddde58a8a773ccce4b6384acacd3ce01373f52717dd2424633ed46755c627", "strip": 1 }
      ],
      "vendor": {
        "commands": ["cargo vendor --locked vendor >/dev/null"],
        "dir": "vendor",
        "sha256": "1eac9184672b435e10482c4d02ad440c5a37173fdb347be33a75d4c4c4e00561"
      },
      "build": [
        "cargo build --offline --locked --release --bin cargo-cbuild --bin cargo-cinstall --config 'source.crates-io.replace-with=\"vendored\"' --config 'source.vendored.directory=\"vendor\"'",
        "mkdir -p \"$PREFIX/bin\"",
        "cp target/release/cargo-cbuild.exe target/release/cargo-cinstall.exe LICENSE README.md \"$PREFIX/bin/\""
      ]
    }
  ]
}
