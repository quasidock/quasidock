{
  "id": "llvm-mingw",
  "version": "20261020",
  "name": "llvm-mingw",
  "summary": "LLVM 23.1.4's Clang, lld and tools with mingw-w64 (UCRT), libc++ and compiler-rt, llvm-mingw's build for x86_64 Windows, as a C and C++ toolchain for builds",
  "homepage": "https://github.com/mstorsjo/llvm-mingw",
  "license": "Apache-2.0 WITH LLVM-exception AND ZPL-2.1 AND MIT AND ISC",
  "entrypoint": "bin/clang.exe",
  "layer": "estargz",
  "path": ["sdk-bin", "bin"],
  "env": {
    "CC": "cc.exe",
    "CXX": "c++.exe",
    "RC": "windres",
    "LDFLAGS": "-s",
    "AR": "ar.exe",
    "RANLIB": "ranlib.exe"
  },
  "permissions": {
    "sandbox": "soft",
    "filesystem": ["cwd"]
  },
  "sdk": { "busybox": "busybox:FRP-6075-g169694ebd@sha256:3d73278be5092691667ebeecd92ffe034fb6898221024e4859325fb379178d2a" },
  "cleanup": [
    "/aarch64-w64-mingw32",
    "/armv7-w64-mingw32",
    "/i686-w64-mingw32",
    "/python",
    "/busybox",
    "aarch64-*",
    "armv7-*",
    "arm64ec-*",
    "i686-*",
    "x86_64-w64-mingw32uwp-*",
    "lldb*",
    "liblldb.dll",
    "libpython3*.dll",
    "libffi-8.dll",
    "clangd.exe",
    "clang-tidy.exe",
    "run-clang-tidy",
    "analyze-build",
    "intercept-build",
    "scan-build-py",
    "/lib/libear",
    "/lib/libscanbuild",
    "gendef.exe",
    "*widl.exe",
    "mingw32-make.exe",
    "/share/gendef",
    "/share/widl",
    "/share/make",
    "/share/man",
    "/share/clang-doc",
    "/x86_64-w64-mingw32/bin"
  ],
  "stages": [
    {
      "name": "llvm-mingw",
      "sources": [
        { "url": "https://github.com/mstorsjo/llvm-mingw/releases/download/20261020/llvm-mingw-20261020-ucrt-x86_64.zip", "sha256": "fd5462b7f5d93b2ff981fcd3f9c7e427e47f3203c64ea91c27bcc444eebd74cd", "strip": 1 }
      ]
    },
    {
      "name": "reproducible",
      "build": [
        "cd \"$PREFIX/x86_64-w64-mingw32/lib\" && rm libc++.dll.a libunwind.dll.a libpthread.dll.a libwinpthread.dll.a libwinpthread.la libomp.dll.a",
        "printf '%s\\n' '# zigsaw: no time in the objects Clang writes or the programs lld links, so that builds are reproducible.' '-mno-incremental-linker-compatible' '-Wl,--no-insert-timestamp' >> \"$PREFIX/bin/mingw32-common.cfg\"",
        "printf 'int main(void) { return 0; }\\n' > t.c && cc -Werror -c t.c -o t1.o && cc -s t.c -o t1.exe && sleep 2 && cc -Werror -c t.c -o t2.o && cc -s t.c -o t2.exe && cmp t1.o t2.o && cmp t1.exe t2.exe",
        "printf '#include <thread>\\nint main() { std::thread t([] {}); t.join(); }\\n' > t.cpp && c++ -s t.cpp -o t.exe && ! llvm-objdump -p t.exe | grep -iE 'DLL Name: lib(c\\+\\+|unwind|winpthread)'"
      ]
    },
    {
      "name": "sdk-commands",
      "sources": [
        { "path": "sdk-tools/launcher.c", "dest": "launcher.c" },
        { "path": "llvm-mingw/commands.h", "dest": "commands.h" }
      ],
      "build": [
        "mkdir -p \"$PREFIX/sdk-bin\"",
        "\"$PREFIX/bin/x86_64-w64-mingw32-clang.exe\" -O2 -municode -s -Wl,--no-insert-timestamp launcher.c -o \"$PREFIX/sdk-bin/cc.exe\"",
        "cp \"$PREFIX/sdk-bin/cc.exe\" \"$PREFIX/sdk-bin/c++.exe\"",
        "cp \"$PREFIX/sdk-bin/cc.exe\" \"$PREFIX/sdk-bin/ar.exe\"",
        "cp \"$PREFIX/sdk-bin/cc.exe\" \"$PREFIX/sdk-bin/ranlib.exe\"",
        "cp \"$PREFIX/sdk-bin/cc.exe\" \"$PREFIX/sdk-bin/nm.exe\"",
        "cp \"$PREFIX/sdk-bin/cc.exe\" \"$PREFIX/sdk-bin/strip.exe\"",
        "cp \"$PREFIX/sdk-bin/cc.exe\" \"$PREFIX/sdk-bin/objdump.exe\"",
        "cp \"$PREFIX/sdk-bin/cc.exe\" \"$PREFIX/sdk-bin/windres.exe\"",
        "cp \"$PREFIX/sdk-bin/cc.exe\" \"$PREFIX/sdk-bin/dlltool.exe\"",
        "cp \"$PREFIX/sdk-bin/cc.exe\" \"$PREFIX/sdk-bin/as.exe\""
      ]
    }
  ]
}
