{
  "id": "gaphor",
  "version": "3.3.2",
  "name": "Gaphor",
  "summary": "Model systems and software in UML, SysML, C4 and RAAML, in Python on GTK 4 and libadwaita",
  "homepage": "https://gaphor.org/",
  "license": "Apache-2.0",
  "entrypoint": ["${pygobject}\\pythonw.exe", "-m", "gaphor"],
  "path": ["bin"],
  "env": {
    "PYTHONPATH": "${app}\\Lib\\site-packages",
    "GI_TYPELIB_PATH": "${app}\\lib\\girepository-1.0;${gtk}\\lib\\girepository-1.0",
    "PYGI_DLL_PATH": "${app}\\bin;${gtk}\\bin",
    "XDG_DATA_DIRS": "${app}\\share",
    "GSETTINGS_SCHEMA_DIR": "${app}\\share\\glib-2.0\\schemas"
  },
  "permissions": {
    "filesystem": ["cwd"]
  },
  "from": {
    "gtk": "gtk4:4.24.1@sha256:0b482850eec817c18cb487fe41fc18e160e7dbbf96c846035e86daed916e22ad",
    "pygobject": "pygobject:3.58.1@sha256:e0326f5760c547a00115333c0ba95b53cb2ec40750ff43a3c6a183560b0d4c3f"
  },
  "sdk": {
    "gtksdk": "gtk4-sdk:4.24.1@sha256:e79afa3f16a0fcf7a6a38a2bd48a705ee1ea711c419d3e9290e4be027ab2c04c",
    "pygobjectsdk": "pygobject-sdk:3.58.1@sha256:4e728524874a95224e4485371424eda1f8b9edea30314fd7f2717091b874c2d1",
    "cmake": "cmake:4.4.4@sha256:dbaa88e42a5efea6ccb235c2ccfb12d6d31d4fa7dc9d266cf81d24a2e3975831"
  },
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/share/gir-1.0",
    "/share/gtksourceview-5/language-specs/check.sh",
    "/share/gtksourceview-5/language-specs/convert.py",
    "/share/gtksourceview-5/styles/check.sh",
    "*.a",
    "*.lib",
    "__pycache__"
  ],
  "stages": [
    {
      "name": "gtksourceview",
      "sources": [
        { "url": "https://download.gnome.org/sources/gtksourceview/5.22/gtksourceview-5.22.0.tar.xz", "sha256": "3ebce33c781e65590a450ecd3ffade480d8e3135b52ee996f1620d6c7dffbbff", "strip": 1 }
      ],
      "build": [
        "meson setup out --prefix=\"$PREFIX\" --buildtype=release -Dbuild-testsuite=false -Dintrospection=enabled -Dvapi=false -Ddocumentation=false -Dsysprof=false",
        "meson install -C out",
        "ls \"$PREFIX/lib/girepository-1.0/GtkSource-5.typelib\""
      ]
    },
    {
      "name": "flex-bison",
      "sources": [
        { "url": "https://github.com/lexxmark/winflexbison/releases/download/v2.5.25/win_flex_bison-2.5.25.zip", "sha256": "8d324b62be33604b2c45ad1dd34ab93d722534448f55a16ca7292de32b6ac135" }
      ],
      "build": ["./win_flex.exe --version && ./win_bison.exe --version"]
    },
    {
      "name": "graphviz",
      "sources": [
        { "url": "https://gitlab.com/graphviz/graphviz/-/archive/16.1.0/graphviz-16.1.0.zip", "sha256": "4bb3694c2f0a1f58886a140df4347df636bdb477f0406de30aeaef0258056aca", "strip": 1 }
      ],
      "build": [
        "cmake -S . -B out -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=OFF -DENABLE_LTDL=OFF -DWITH_EXPAT=OFF -DWITH_GVEDIT=OFF -DWITH_SMYRNA=OFF -DWITH_ZLIB=OFF -DENABLE_TCL=OFF -DENABLE_SWIG=OFF -DENABLE_SHARP=OFF -DENABLE_D=OFF -DENABLE_GO=OFF -DENABLE_GUILE=OFF -DENABLE_JAVA=OFF -DENABLE_JAVASCRIPT=OFF -DENABLE_LUA=OFF -DENABLE_PERL=OFF -DENABLE_PHP=OFF -DENABLE_PYTHON=OFF -DENABLE_R=OFF -DENABLE_RUBY=OFF -DWITH_GDK=OFF -DWITH_GHOSTSCRIPT=OFF -DWITH_GTK=OFF -DWITH_POPPLER=OFF -DWITH_QUARTZ=OFF -DWITH_RSVG=OFF -DWITH_WEBP=OFF -DWITH_X=OFF -Duse_win_pre_inst_libs=OFF -Dinstall_win_dependency_dlls=OFF -DCMAKE_DISABLE_FIND_PACKAGE_CAIRO=ON -DCMAKE_DISABLE_FIND_PACKAGE_PANGOCAIRO=ON -DCMAKE_DISABLE_FIND_PACKAGE_GD=ON -DCMAKE_DISABLE_FIND_PACKAGE_GTS=ON -DCMAKE_DISABLE_FIND_PACKAGE_ANN=ON -DCMAKE_DISABLE_FIND_PACKAGE_DevIL=ON -DCMAKE_DISABLE_FIND_PACKAGE_AA=ON -DCMAKE_DISABLE_FIND_PACKAGE_Freetype=ON -DCMAKE_DISABLE_FIND_PACKAGE_LASI=ON -DCMAKE_DISABLE_FIND_PACKAGE_GLUT=ON -DCMAKE_DISABLE_FIND_PACKAGE_Fontconfig=ON -DBISON_EXECUTABLE=B:/src/flex-bison/win_bison.exe -DFLEX_EXECUTABLE=B:/src/flex-bison/win_flex.exe",
        "cmake --build out --target dot",
        "mkdir -p \"$PREFIX/bin\" && cp out/cmd/dot/dot.exe \"$PREFIX/bin/\"",
        "echo 'digraph { a -> b }' | \"$PREFIX/bin/dot.exe\" -Tdot | grep -q 'a -> b'"
      ]
    },
    {
      "name": "gaphor",
      "sources": [
        { "url": "https://files.pythonhosted.org/packages/2e/9f/33c39e6c936a167a299f99a1ac87b0a487974ffd8b8eb33398e20b5566f9/gaphor-3.3.2.tar.gz", "sha256": "dc4cad4df94e861584923091e5eab45fc13e4c84d3bd0bd8606b0f2b3ba2bfba", "strip": 1 },
        { "path": "gaphor/requirements.txt", "dest": "quasidock/requirements.txt" },
        { "path": "gaphor/build-requirements.txt", "dest": "quasidock/build-requirements.txt" },
        { "path": "gtk4-sdk/svg2ico.sh", "dest": "quasidock/svg2ico.sh" }
      ],
      "vendor": {
        "commands": [
          "python3 -m pip download --no-cache-dir --disable-pip-version-check --no-deps --only-binary=:all: --platform win_amd64 --python-version 3.14 --implementation cp --require-hashes -r quasidock/requirements.txt -r quasidock/build-requirements.txt -d wheels"
        ],
        "dir": "wheels",
        "sha256": "4e373f0012e8c1b2daa7c4ec0aa855e37079cd0ff9506cf405a0241577b8fa70"
      },
      "build": [
        "python3 -m pip install --no-cache-dir --disable-pip-version-check --no-index --find-links wheels --no-deps --no-compile --require-hashes --target B:/build-tools -r quasidock/build-requirements.txt",
        "python3 -m pip install --no-cache-dir --disable-pip-version-check --no-index --find-links wheels --no-deps --no-compile --require-hashes --target \"$PREFIX/Lib/site-packages\" -r quasidock/requirements.txt",
        "PYTHONPATH=B:/build-tools python3 -m pip install --no-cache-dir --disable-pip-version-check --no-index --no-deps --no-compile --no-build-isolation --target \"$PREFIX/Lib/site-packages\" .",
        "rm -rf \"$PREFIX/Lib/site-packages/bin\"",
        "for r in \"$PREFIX\"/Lib/site-packages/*.dist-info/RECORD; do grep -v '^[.][.]/[.][.]/bin/' \"$r\" > quasidock/RECORD && mv quasidock/RECORD \"$r\" || exit 1; done",
        "! grep -l '^[.][.]/[.][.]/bin/' \"$PREFIX\"/Lib/site-packages/*.dist-info/RECORD",
        "mkdir -p \"$PREFIX/share/glib-2.0/schemas\" \"$PREFIX/share/icons\"",
        "cp gaphor/ui/installschemas/org.gaphor.Gaphor.gschema.xml \"$PREFIX/share/glib-2.0/schemas/\"",
        "glib-compile-schemas \"$PREFIX/share/glib-2.0/schemas\"",
        "sh quasidock/svg2ico.sh gaphor/ui/icons/hicolor/scalable/apps/org.gaphor.Gaphor.svg \"$PREFIX/share/icons/org.gaphor.Gaphor.ico\"",
        "ls \"$PREFIX/Lib/site-packages/gaphor/__main__.py\" \"$PREFIX/Lib/site-packages/PIL/__init__.py\" \"$PREFIX/share/glib-2.0/schemas/gschemas.compiled\""
      ]
    }
  ]
}
