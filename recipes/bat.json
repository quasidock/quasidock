{
  "id": "bat",
  "version": "0.26.1",
  "name": "bat",
  "summary": "A cat clone with syntax highlighting and Git integration",
  "homepage": "https://github.com/sharkdp/bat",
  "license": "MIT OR Apache-2.0",
  "entrypoint": "bat.exe",
  "permissions": {
    "filesystem": ["cwd:ro"]
  },
  "sdk": {
    "rust": "rust:1.99.0@sha256:a7657fc530d9b76b81a20116d5f02097d6922294f39163d202a6d0ca9fca6e9b",
    "zig": "zig:0.17.0@sha256:d56d973884d07ce551d9697535f43d18183a3ce0ee3f79f0c9d40ce041842d5f",
    "busybox": "busybox:FRP-6075-g169694ebd@sha256:3d73278be5092691667ebeecd92ffe034fb6898221024e4859325fb379178d2a"
  },
  "stages": [
    {
      "name": "bat",
      "sources": [
        { "url": "https://static.crates.io/crates/bat/bat-0.26.1.crate", "sha256": "cf66d0164db6827afe1694b8d4939f36a5507b7186f8d3cc529c66baf03b0d09", "strip": 1 }
      ],
      "vendor": {
        "commands": ["cargo vendor --locked vendor >/dev/null"],
        "dir": "vendor",
        "sha256": "9a65f01421cf29a9d6f622d69787ebd33e7207da7ecf27f330dd2b581c4bf892"
      },
      "build": [
        "cargo build --offline --locked --release --config 'source.crates-io.replace-with=\"vendored\"' --config 'source.vendored.directory=\"vendor\"'",
        "mkdir -p \"$PREFIX/autocomplete\"",
        "cp target/release/bat.exe README.md LICENSE-MIT LICENSE-APACHE CHANGELOG.md target/release/build/bat-*/out/assets/manual/bat.1 \"$PREFIX/\"",
        "cp target/release/build/bat-*/out/assets/completions/* \"$PREFIX/autocomplete/\""
      ]
    }
  ]
}
