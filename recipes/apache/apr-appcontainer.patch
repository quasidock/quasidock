@@ -36,6 +36,21 @@
  *
  * OS2 appears immune from the nonsense :)
  */
+
+/* AppContainers may traverse an ancestor without permission to list it.
+ * Keep validating later components; the final component must still be readable.
+ */
+static int filepath_in_appcontainer(void)
+{
+    HANDLE token;
+    DWORD is_appcontainer = 0, size;
+    if (OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY, &token)) {
+        GetTokenInformation(token, TokenIsAppContainer, &is_appcontainer,
+                            sizeof(is_appcontainer), &size);
+        CloseHandle(token);
+    }
+    return is_appcontainer != 0;
+}
 
