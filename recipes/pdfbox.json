{
  "id": "pdfbox",
  "version": "3.0.8",
  "name": "Apache PDFBox",
  "summary": "Work with PDF documents from the command line (extract text and images, merge, split, render) and look inside them with its debugger",
  "homepage": "https://pdfbox.apache.org/",
  "license": "Apache-2.0 AND MIT",
  "entrypoint": ["${java}\\bin\\java.exe", "-jar", "${app}\\pdfbox-app.jar"],
  "permissions": {
    "filesystem": ["cwd"]
  },
  "registry": ["Software\\JavaSoft\\Prefs\\org\\apache\\pdfbox"],
  "from": { "java": "java:25.0.5_8@sha256:cf6e3c25a745b91bd94d4aebff340702f7ef7e6935f1f91c9ef322daec09291d" },
  "sdk": {
    "maven": "maven:3.10.0@sha256:50dfb31e20a15df21eca3f40aca42e05009ef4066997d755eeca16ecc19d4d3f",
    "busybox": "busybox:FRP-6075-g169694ebd@sha256:baca1ecd27b7b5ffe54402d4f8b6e36802d9db5e0e4cb2b7ab13104031045c50"
  },
  "stages": [
    {
      "name": "pdfbox",
      "sources": [
        { "url": "https://repo.maven.apache.org/maven2/org/apache/pdfbox/pdfbox-reactor/3.0.8/pdfbox-reactor-3.0.8-source-release.zip", "sha256": "0319436e3c5238f363b873973fe03d4a5af1c985e1e2ff0ae20e2a56f180cca7", "strip": 1 }
      ],
      "vendor": {
        "commands": [
          "mvn -B -ntp -Dmaven.repo.local=vendor -pl :pdfbox-app -am package -DskipTests",
          "find vendor \\( -name _remote.repositories -o -name '*.lastUpdated' -o -name resolver-status.properties -o -name 'maven-metadata-*.xml' \\) -delete",
          "rm -rf vendor/.meta"
        ],
        "dir": "vendor",
        "sha256": "e5513fb7ef22fc74dded614e01034b93e6c1e5af5fb306cc6a8664a47127a58b"
      },
      "build": [
        "mvn -B -ntp -o -Dmaven.repo.local=\"$PWD/vendor\" -pl :pdfbox-app -am package -DskipTests",
        "cp app/target/pdfbox-app-3.0.8.jar \"$PREFIX/pdfbox-app.jar\"",
        "cp LICENSE.txt NOTICE.txt \"$PREFIX/\""
      ]
    }
  ]
}
