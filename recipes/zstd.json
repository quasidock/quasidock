{
  "id": "zstd",
  "version": "1.5.7",
  "name": "Zstandard",
  "summary": "Fast lossless compression: the zstd command-line tool",
  "homepage": "https://facebook.github.io/zstd/",
  "license": "BSD-3-Clause OR GPL-2.0-only",
  "entrypoint": "bin/zstd.exe",
  "permissions": {
    "filesystem": ["cwd"]
  },
  "sdk": {
    "cmake": "cmake:4.4.4@sha256:bb0949026f8d4c087ebaf2e8bd385e4202363c8fa48fc70ede498958b5a0f8af",
    "zig": "zig:0.17.0@sha256:d56d973884d07ce551d9697535f43d18183a3ce0ee3f79f0c9d40ce041842d5f",
    "busybox": "busybox:FRP-6075-g169694ebd@sha256:3d73278be5092691667ebeecd92ffe034fb6898221024e4859325fb379178d2a"
  },
  "cleanup": ["/include", "/lib"],
  "stages": [
    {
      "name": "zstd",
      "sources": [
        { "url": "https://github.com/facebook/zstd/releases/download/v1.5.7/zstd-1.5.7.tar.gz", "sha256": "eb33e51f49a15e023950cd7825ca74a4a2b43db8354825ac24fc1b7ee09e6fa3", "strip": 1 }
      ],
      "build": [
        "cmake -S build/cmake -B out -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=\"$PREFIX\" -DZSTD_BUILD_SHARED=OFF -DZSTD_BUILD_TESTS=OFF",
        "cmake --build out",
        "cmake --install out",
        "cp LICENSE COPYING README.md \"$PREFIX/\""
      ]
    }
  ]
}
