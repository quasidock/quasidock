{
  "id": "gnumeric",
  "version": "1.12.62",
  "name": "Gnumeric",
  "summary": "A spreadsheet that reads and writes Excel, OpenDocument and many other formats, on GTK 3",
  "homepage": "https://gnome.pages.gitlab.gnome.org/gnumeric-web/",
  "license": "GPL-2.0-only OR GPL-3.0-only",
  "entrypoint": "bin/gnumeric.exe",
  "path": ["bin"],
  "env": { "XDG_DATA_DIRS": "${app}\\share" },
  "permissions": {
    "filesystem": ["cwd"]
  },
  "from": {
    "gtk": "gtk4:4.24.1@sha256:0b482850eec817c18cb487fe41fc18e160e7dbbf96c846035e86daed916e22ad",
    "gtk3": "gtk3:3.24.52@sha256:a33ddea1c1cfe7592a4eb1cd4fe8fc4c58bccaf5e7dbf92ee4d0c4497b239015"
  },
  "sdk": {
    "gtksdk": "gtk4-sdk:4.24.1@sha256:e79afa3f16a0fcf7a6a38a2bd48a705ee1ea711c419d3e9290e4be027ab2c04c",
    "gtk3sdk": "gtk3-sdk:3.24.52@sha256:25d75ab09e4b13d03ef459b941b2c04bda233739d2a62b5ceb9e89688d15a3b8",
    "cmake": "cmake:4.4.4@sha256:dbaa88e42a5efea6ccb235c2ccfb12d6d31d4fa7dc9d266cf81d24a2e3975831",
    "perl": "perl:5.42.3.1@sha256:2854c34722b812ef3173f5d4ab6fb091ac45dc16d6079865a5024d6a6527dfd6"
  },
  "cleanup": [
    "/include",
    "/lib/cmake",
    "/lib/pkgconfig",
    "/lib/xsltConf.sh",
    "*.a",
    "*.la",
    "*.lib",
    "*-config",
    "/bin/python3",
    "/bin/intltool-*",
    "/bin/intltoolize",
    "/share/intltool",
    "/share/aclocal",
    "/share/applications",
    "/share/metainfo",
    "/share/gtk-doc",
    "/share/man",
    "/share/doc"
  ],
  "stages": [
    {
      "name": "build-tools",
      "build": ["mkdir -p \"$PREFIX/bin\"", "printf '%s\\n' '#!/bin/sh' 'exec python \"$@\"' > \"$PREFIX/bin/python3\""]
    },
    {
      "name": "libxslt",
      "sources": [
        { "url": "https://download.gnome.org/sources/libxslt/1.1/libxslt-1.1.45.tar.xz", "sha256": "9acfe68419c4d06a45c550321b3212762d92f41465062ca4ea19e632ee5d216e", "strip": 1 }
      ],
      "build": [
        "x=$(pkg-config --variable=prefix libxml-2.0) && mkdir -p quasidock/libxml2 && sed \"s|B:/prefix|$x|g\" \"$x/lib/cmake/libxml2/libxml2-config.cmake\" > quasidock/libxml2/libxml2-config.cmake",
        "cmake -S . -B out -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=\"$PREFIX\" -DLibXml2_DIR=B:/src/libxslt/quasidock/libxml2 -DLIBXSLT_WITH_PYTHON=OFF -DLIBXSLT_WITH_TESTS=OFF -DLIBXSLT_WITH_PROGRAMS=OFF -DLIBXSLT_WITH_PROFILER=OFF",
        "cmake --build out",
        "cmake --install out"
      ]
    },
    {
      "name": "libgsf",
      "env": {
        "SED": "sed",
        "GREP": "grep",
        "EGREP": "grep -E",
        "FGREP": "grep -F",
        "AWK": "awk",
        "AR": "ar.exe",
        "RANLIB": "ranlib.exe",
        "RM": "rm -f",
        "CFLAGS": "-O2",
        "PATH_SEPARATOR": ";",
        "PERL": "perl"
      },
      "sources": [
        { "url": "https://download.gnome.org/sources/libgsf/1.14/libgsf-1.14.60.tar.xz", "sha256": "83e12c36a099a8a7019bf425e2c24af66eeb2ef5874251e694431a07d9805dae", "strip": 1 },
        { "path": "gtk4-sdk/autotools-mtimes.sh", "dest": "quasidock/mtimes.sh" }
      ],
      "build": [
        "sh quasidock/mtimes.sh",
        "{ echo EXPORTS; cat gsf/libgsf.syms; } > gsf/libgsf.def",
        "sed -i 's|^\t$(srcdir)/libgsf.syms $(am__append_2)$|\t$(srcdir)/libgsf.def $(am__append_2)|' gsf/Makefile.in",
        "grep -q '(srcdir)/libgsf.def ' gsf/Makefile.in",
        "sdk=$(pkg-config --variable=prefix glib-2.0) && sh ./configure --build=x86_64-w64-mingw32 --host=x86_64-w64-mingw32 --prefix=\"$PREFIX\" --disable-static --disable-dependency-tracking --disable-introspection --disable-gtk-doc --without-gdk-pixbuf --without-bz2 --with-libiconv-prefix=\"$sdk\" --with-libintl-prefix=\"$sdk\" CPPFLAGS=\"-I$sdk/include\" LDFLAGS=\"$LDFLAGS -L$sdk/lib\" ac_executable_extensions=.exe lt_cv_deplibs_check_method=pass_all > configure.log 2>&1 || { tail -60 config.log; exit 1; }",
        "make -j\"$(nproc)\" -C gsf",
        "make -C po",
        "make -C gsf install",
        "make -C po install",
        "make install-pkgconfigDATA"
      ]
    },
    {
      "name": "intltool",
      "env": { "SED": "sed", "GREP": "grep", "EGREP": "grep -E", "FGREP": "grep -F", "AWK": "awk", "PATH_SEPARATOR": ";" },
      "sources": [
        { "url": "https://launchpad.net/intltool/trunk/0.51.0/+download/intltool-0.51.0.tar.gz", "sha256": "67c74d94196b153b774ab9f89b2fa6c6ba79352407037c8c14d5aeb334e959cd", "strip": 1 },
        { "path": "gtk4-sdk/autotools-mtimes.sh", "dest": "quasidock/mtimes.sh" }
      ],
      "build": [
        "sh quasidock/mtimes.sh",
        "sed -i 's/^%: %.in Makefile$/.SUFFIXES: .in\\n.in:/' Makefile.in",
        "grep -q '^\\.in:$' Makefile.in",
        "sh ./configure --prefix=\"$PREFIX\" ac_executable_extensions=.exe > configure.log 2>&1 || { tail -60 config.log; exit 1; }",
        "make",
        "make install",
        "sed -i '1s|^#!.*/perl.exe|#!/usr/bin/perl|' \"$PREFIX\"/bin/intltool-*",
        "head -1 \"$PREFIX/bin/intltool-merge\" | grep -q '^#!/usr/bin/perl -w$'"
      ]
    },
    {
      "name": "goffice",
      "env": {
        "SED": "sed",
        "GREP": "grep",
        "EGREP": "grep -E",
        "FGREP": "grep -F",
        "AWK": "awk",
        "AR": "ar.exe",
        "RANLIB": "ranlib.exe",
        "RM": "rm -f",
        "CFLAGS": "-O2 -Wno-implicit-function-declaration",
        "CPP": "cc -E",
        "PATH_SEPARATOR": ";",
        "PERL": "perl",
        "PERLIO": "perlio"
      },
      "sources": [
        { "url": "https://download.gnome.org/sources/goffice/0.10/goffice-0.10.62.tar.xz", "sha256": "500eaff50628faa75adb3cd560236a4db498d9e7c52c036b78fa9a57f21805b3", "strip": 1 },
        { "path": "gtk4-sdk/autotools-mtimes.sh", "dest": "quasidock/mtimes.sh" },
        { "path": "gnumeric/pdpmake.sh", "dest": "quasidock/pdpmake.sh" }
      ],
      "build": [
        "sh quasidock/mtimes.sh",
        "find . -name '*.h.in' -exec touch -t 200001010000.02 {} +",
        "sh quasidock/pdpmake.sh",
        "sdk=$(pkg-config --variable=prefix glib-2.0) && sh ./configure --build=x86_64-w64-mingw32 --host=x86_64-w64-mingw32 --prefix=\"$PREFIX\" --disable-static --disable-dependency-tracking --disable-introspection --disable-gtk-doc --with-config-backend=keyfile --without-long-double --with-lasem=no --with-libiconv-prefix=\"$sdk\" --with-libintl-prefix=\"$sdk\" CPPFLAGS=\"-I$sdk/include\" LDFLAGS=\"$LDFLAGS -L$sdk/lib\" ac_executable_extensions=.exe lt_cv_deplibs_check_method=pass_all > configure.log 2>&1 || { tail -60 config.log; exit 1; }",
        "grep -q 'Configuration backend:\tkeyfile' configure.log",
        "make -j\"$(nproc)\"",
        "make install"
      ]
    },
    {
      "name": "gnumeric",
      "env": {
        "SED": "sed",
        "GREP": "grep",
        "EGREP": "grep -E",
        "FGREP": "grep -F",
        "AWK": "awk",
        "AR": "ar.exe",
        "RANLIB": "ranlib.exe",
        "RM": "rm -f",
        "CFLAGS": "-O2 -DGNM_VAR_DECL=extern -Wno-implicit-function-declaration",
        "CPP": "cc -E",
        "PATH_SEPARATOR": ";",
        "PERL": "perl",
        "PERLIO": "perlio",
        "YACC": "true",
        "ITSTOOL": "true",
        "XMLLINT": "xmllint",
        "GLIB_GENMARSHAL": "glib-genmarshal"
      },
      "sources": [
        { "url": "https://download.gnome.org/sources/gnumeric/1.12/gnumeric-1.12.62.tar.xz", "sha256": "89331121321b9bad72d37af5a6d13a0a636f0fbb0880f0ea1f2cf8b7ab9ae631", "strip": 1 },
        { "path": "gtk4-sdk/autotools-mtimes.sh", "dest": "quasidock/mtimes.sh" },
        { "path": "gnumeric/pdpmake.sh", "dest": "quasidock/pdpmake.sh" }
      ],
      "build": [
        "sh quasidock/mtimes.sh",
        "find . -name '*.h.in' -exec touch -t 200001010000.02 {} +",
        "sh quasidock/pdpmake.sh",
        "sed -i 's/^SUBDIRS = \\(.*\\) templates doc tools schemas test introspection$/SUBDIRS = \\1 templates/' Makefile.in",
        "grep -q '^SUBDIRS = .* icons @COMPONENT_DIR@ templates$' Makefile.in",
        "sed -i 's/ plan-perfect applix openoffice / plan-perfect openoffice /' plugins/Makefile.in",
        "grep -q 'qpro plan-perfect openoffice mps' plugins/Makefile.in",
        "sed -i 's/^@WITH_NATIVE_WIN32_TRUE@am__append_10 = -no-undefined -export-symbols libspreadsheet.def$/@WITH_NATIVE_WIN32_TRUE@am__append_10 = -no-undefined -Wl,--export-all-symbols/' src/Makefile.in",
        "grep -q '^@WITH_NATIVE_WIN32_TRUE@am__append_10 = -no-undefined -Wl,--export-all-symbols$' src/Makefile.in",
        "sed -i '/g_option_context_set_delocalize/d' src/main-application.c",
        "! grep -q set_delocalize src/main-application.c",
        "sdk=$(pkg-config --variable=prefix glib-2.0) && sh ./configure --build=x86_64-w64-mingw32 --host=x86_64-w64-mingw32 --prefix=\"$PREFIX\" --disable-static --disable-dependency-tracking --disable-introspection --disable-gtk-doc --without-python --without-perl --with-gda=no --without-psiconv --without-paradox --with-libiconv-prefix=\"$sdk\" --with-libintl-prefix=\"$sdk\" CPPFLAGS=\"-I$sdk/include\" LDFLAGS=\"$LDFLAGS -L$sdk/lib\" ac_executable_extensions=.exe lt_cv_deplibs_check_method=pass_all > configure.log 2>&1 || { tail -60 config.log; exit 1; }",
        "make -j\"$(nproc)\"",
        "make install",
        "mkdir -p \"$PREFIX/share/icons\" && cp icons/win32-gnumeric.ico \"$PREFIX/share/icons/gnumeric.ico\""
      ]
    }
  ]
}
