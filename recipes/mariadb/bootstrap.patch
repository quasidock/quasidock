+
+/* Launch bootstrap directly: AppContainers cannot use cmd.exe or its NUL
+   redirections. Only the child's stdin pipe and existing output are inherited. */
+static FILE *bootstrap_open(char *cmdline, HANDLE *process)
+{
+  SECURITY_ATTRIBUTES security = {sizeof(security), NULL, TRUE};
+  HANDLE input = NULL, output = NULL;
+  if (!CreatePipe(&input, &output, &security, 0))
+    return NULL;
+  SetHandleInformation(output, HANDLE_FLAG_INHERIT, 0);
+  STARTUPINFOA startup = {};
+  PROCESS_INFORMATION child = {};
+  startup.cb = sizeof(startup);
+  startup.dwFlags = STARTF_USESTDHANDLES;
+  startup.hStdInput = input;
+  startup.hStdOutput = GetStdHandle(STD_OUTPUT_HANDLE);
+  startup.hStdError = GetStdHandle(STD_ERROR_HANDLE);
+  SetHandleInformation(startup.hStdOutput, HANDLE_FLAG_INHERIT, HANDLE_FLAG_INHERIT);
+  SetHandleInformation(startup.hStdError, HANDLE_FLAG_INHERIT, HANDLE_FLAG_INHERIT);
+  BOOL started = CreateProcessA(mysqld_path, cmdline, NULL, NULL, TRUE,
+                               0, NULL, NULL, &startup, &child);
+  CloseHandle(input);
+  if (!started)
+  {
+    CloseHandle(output);
+    return NULL;
+  }
+  CloseHandle(child.hThread);
+  int fd = _open_osfhandle((intptr_t)output, _O_WRONLY | _O_TEXT);
+  FILE *stream = fd < 0 ? NULL : _fdopen(fd, "w");
+  if (!stream)
+  {
+    if (fd < 0) CloseHandle(output); else _close(fd);
+    WaitForSingleObject(child.hProcess, INFINITE);
+    CloseHandle(child.hProcess);
+    return NULL;
+  }
+  *process = child.hProcess;
+  return stream;
+}
+
+static int bootstrap_close(FILE *stream, HANDLE process)
+{
+  int failed = fclose(stream);
+  DWORD code = 1;
+  if (WaitForSingleObject(process, INFINITE) == WAIT_OBJECT_0)
+    GetExitCodeProcess(process, &code);
+  CloseHandle(process);
+  return failed ? 1 : (int)code;
 }
 
