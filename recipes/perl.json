{
  "id": "perl",
  "version": "5.42.3.1",
  "name": "Perl",
  "summary": "The Perl programming language, as Strawberry Perl's portable distribution",
  "homepage": "https://strawberryperl.com/",
  "license": "Artistic-1.0-Perl OR GPL-1.0-or-later",
  "entrypoint": "perl/bin/perl.exe",
  "path": ["perl/bin"],
  "env": { "SSL_CERT_FILE": "${roots}" },
  "permissions": {
    "filesystem": ["cwd"]
  },
  "sdk": { "busybox": "busybox:FRP-6075-g169694ebd@sha256:baca1ecd27b7b5ffe54402d4f8b6e36802d9db5e0e4cb2b7ab13104031045c50" },
  "cleanup": [
    "/c",
    "/data",
    "/win32",
    "/perl/site",
    "/perl/html",
    "/perl/man",
    "/perl/bin/pkg-config",
    "/perl/bin/pkg-config.bat",
    "*.pod",
    "/portableshell.bat",
    "/relocation.pl.bat",
    "/update_env.pl.bat",
    "/README.txt",
    "/DISTRIBUTIONS.txt"
  ],
  "stages": [
    {
      "name": "perl",
      "sources": [
        { "url": "https://github.com/StrawberryPerl/Perl-Dist-Strawberry/releases/download/SP_54231_64bit/strawberry-perl-5.42.3.1-64bit-portable.zip", "sha256": "6a081a811781c30aca51dbc036afd93092af91e3297901f02c17043795a10690" }
      ]
    },
    {
      "name": "xs-dlls",
      "sources": [
        { "url": "https://github.com/StrawberryPerl/Perl-Dist-Strawberry/releases/download/SP_54231_64bit/strawberry-perl-5.42.3.1-64bit-portable.zip", "sha256": "6a081a811781c30aca51dbc036afd93092af91e3297901f02c17043795a10690", "type": "file", "dest": "strawberry.zip" }
      ],
      "build": [
        "unzip -q strawberry.zip 'c/bin/*__.dll'",
        "test -f c/bin/libexpat-1__.dll",
        "mkdir -p \"$PREFIX/perl/bin\" && cp c/bin/*__.dll \"$PREFIX/perl/bin/\""
      ]
    }
  ]
}
