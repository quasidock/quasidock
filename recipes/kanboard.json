{
  "id": "kanboard",
  "version": "1.2.57",
  "name": "Kanboard",
  "summary": "Kanban project management, served by PHP's built-in web server and opened in your browser, with its database in the app's data",
  "homepage": "https://kanboard.org/",
  "license": "MIT",
  "entrypoint": ["${php}\\php.exe", "${app}\\serve.php"],
  "env": {
    "DATA_DIR": "${data}",
    "PLUGINS_DIR": "${data}\\plugins",
    "KANBOARD_LISTEN": "127.0.0.1:${listen:http}",
    "KANBOARD_URL": "http://127.0.0.1:${port:http}/"
  },
  "permissions": {
    "sandbox": "soft",
    "network": true,
    "services": [
      { "name": "http", "port": 8471 }
    ],
    "unsupported": { "low": "PHP's is_writable() is false for everything at low integrity, so Kanboard says its data can't be written" }
  },
  "from": { "php": "php:8.5.12-1@sha256:12e0c8ba350be5cbc974ed42cf87358136479e8b8b5960e7ea9720643c445df5" },
  "sdk": {
    "composer": "composer:2.10.3@sha256:8a70709c07ddec60e2bfca5487d2a4596fe88272e68d4b1e080c7d5d87f3634b",
    "busybox": "busybox:FRP-6075-g169694ebd@sha256:baca1ecd27b7b5ffe54402d4f8b6e36802d9db5e0e4cb2b7ab13104031045c50"
  },
  "stages": [
    {
      "name": "kanboard",
      "sources": [
        { "url": "https://github.com/kanboard/kanboard/archive/refs/tags/v1.2.57.tar.gz", "sha256": "4f0e6d07ddf17361d2ccfa0d3910a18c3e8334816744cf1b220bff4a181fa5f4", "strip": 1 },
        { "url": "https://raw.githubusercontent.com/kanboard/kanboard/2ddb31bf72d355727d0639fc3423630f3bae1a9c/composer.json", "sha256": "48da225091408b7ccb372ff6699050af937784fca05a6d6015e659c329413295", "dest": "composer.json" },
        { "url": "https://raw.githubusercontent.com/kanboard/kanboard/2ddb31bf72d355727d0639fc3423630f3bae1a9c/composer.lock", "sha256": "be22d1d4427e19cb6f907fd9a7d6e4d577a9cb1b98c04839656c15c0ab2384a4", "dest": "composer.lock" }
      ],
      "vendor": {
        "commands": ["rm -rf vendor", "composer install --no-dev --no-scripts --no-interaction --no-ansi --prefer-dist"],
        "dir": "vendor",
        "sha256": "698430c1ab49fc11d1367e81d6e3b460280a3859f5744bd475589da2308007ee"
      },
      "build": [
        "mkdir -p \"$PREFIX/kanboard\"",
        "cp -r app assets libs vendor cli index.php jsonrpc.php config.default.php favicon.ico robots.txt LICENSE ChangeLog \"$PREFIX/kanboard/\""
      ]
    },
    {
      "name": "quasidock",
      "sources": [
        { "path": "kanboard/serve.php", "dest": "serve.php" },
        { "path": "kanboard/router.php", "dest": "router.php" }
      ]
    }
  ]
}
