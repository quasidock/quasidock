+/* GetLongPathName requires listing every ancestor. An AppContainer may only
+ * traverse those ancestors, while holding a grant for the requested file.
+ * Validate the final name from a readable handle instead. Also validate each
+ * component containing '~', so 8.3 aliases cannot bypass location matching.
+ * OPEN_REPARSE_POINT preserves the spelling of a mounted directory's junction.
+ */
+static ngx_int_t
+ngx_win32_check_component(u_short *u, u_short *end)
+{
+    HANDLE     file;
+    DWORD      n, size;
+    u_short    saved, *name, *canonical, *base;
+    ngx_err_t  err;
+    ngx_int_t  result;
+
+    saved = *end;
+    *end = 0;
+    file = CreateFileW(u, FILE_READ_ATTRIBUTES,
+                       FILE_SHARE_READ|FILE_SHARE_WRITE|FILE_SHARE_DELETE,
+                       NULL, OPEN_EXISTING,
+                       FILE_FLAG_BACKUP_SEMANTICS|FILE_FLAG_OPEN_REPARSE_POINT,
+                       NULL);
+    if (file == INVALID_HANDLE_VALUE) {
+        *end = saved;
+        return NGX_ERROR;
+    }
+
+    result = NGX_ERROR;
+    canonical = NULL;
+    size = GetFinalPathNameByHandleW(file, NULL, 0, VOLUME_NAME_NONE);
+    if (size == 0) {
+        goto done;
+    }
+    canonical = ngx_alloc((size + 1) * sizeof(u_short), ngx_cycle->log);
+    if (canonical == NULL) {
+        goto done;
+    }
+    n = GetFinalPathNameByHandleW(file, canonical, size + 1, VOLUME_NAME_NONE);
+    if (n == 0 || n > size) {
+        goto done;
+    }
+
+    base = canonical + n;
+    while (base > canonical && base[-1] != '\\' && base[-1] != '/') {
+        base--;
+    }
+    name = end;
+    while (name > u && name[-1] != '\\' && name[-1] != '/') {
+        name--;
+    }
+    if (_wcsicmp(name, base) != 0) {
+        ngx_set_errno(NGX_ENOENT);
+        goto done;
+    }
+    result = NGX_OK;
+
+done:
+    err = ngx_errno;
+    if (canonical) {
+        ngx_free(canonical);
+    }
+    CloseHandle(file);
+    *end = saved;
+    ngx_set_errno(err);
+    return result;
+}
+
+
+static ngx_int_t
+ngx_win32_check_granted_path(u_short *u)
+{
+    HANDLE     token;
+    DWORD      appcontainer, size;
+    u_short   *p, *end;
+    ngx_uint_t alias;
+
+    appcontainer = 0;
+    if (!OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY, &token)) {
+        return NGX_ERROR;
+    }
+    size = sizeof(appcontainer);
+    GetTokenInformation(token, TokenIsAppContainer, &appcontainer, size, &size);
+    CloseHandle(token);
+    if (!appcontainer) {
+        ngx_set_errno(NGX_EACCES);
+        return NGX_ERROR;
+    }
+
+    end = u + wcslen(u);
+    while (end > u + 3 && (end[-1] == '/' || end[-1] == '\\')) {
+        end--;
+    }
+    alias = 0;
+    for (p = u; p < end; p++) {
+        if (*p == '~') {
+            alias = 1;
+        }
+        if (*p == '/' || *p == '\\') {
+            if (alias && ngx_win32_check_component(u, p) != NGX_OK) {
+                return NGX_ERROR;
+            }
+            alias = 0;
+        }
+    }
+    return ngx_win32_check_component(u, end);
 }
 
 
