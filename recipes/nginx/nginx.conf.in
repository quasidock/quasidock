# Generated by the Quasidock launcher. Put server directives in conf.d/*.conf,
# or supply a complete configuration with -c.
daemon off;
worker_processes 1;
pid @PID@;
error_log @ERROR@ notice;
events {
    worker_connections 1024;
}
http {
    include @MIME@;
    default_type application/octet-stream;
    access_log @ACCESS@;
    client_body_temp_path @CLIENT@;
    proxy_temp_path @PROXY@;
    fastcgi_temp_path @FASTCGI@;
    uwsgi_temp_path @UWSGI@;
    scgi_temp_path @SCGI@;
    sendfile on;
    gzip on;
    gzip_types text/plain text/css application/javascript application/json;
    server_tokens off;
    server {
        listen 127.0.0.1:@HTTP@;
        server_name localhost;
        root @ROOT@;
        index index.html;
        @TLS@
        location ~ /\. {
            deny all;
        }
        include @SNIPPETS@;
    }
}
