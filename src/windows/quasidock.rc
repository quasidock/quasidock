// The version information of quasidock.exe and its helpers, which Explorer shows
// in a file's properties:
//
//   QUASIDOCK_VERSION          "0.2.0"
//   QUASIDOCK_VERSION_NUMBERS  0,2,0,0
//   QUASIDOCK_DESCRIPTION      what the program is
//   QUASIDOCK_FILE_NAME        "quasidock.exe", the name it's built as
//
// Numbers stand for winver.h's names (VOS_NT_WINDOWS32, VFT_APP).

1 VERSIONINFO
FILEVERSION QUASIDOCK_VERSION_NUMBERS
PRODUCTVERSION QUASIDOCK_VERSION_NUMBERS
FILEFLAGSMASK 0x3f
FILEFLAGS 0x0
FILEOS 0x40004
FILETYPE 0x1
FILESUBTYPE 0x0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Bradley Tran"
            VALUE "FileDescription", QUASIDOCK_DESCRIPTION
            VALUE "FileVersion", QUASIDOCK_VERSION
            VALUE "InternalName", QUASIDOCK_FILE_NAME
            VALUE "LegalCopyright", "Copyright (c) 2026, Bradley Tran. BSD 3-Clause License."
            VALUE "OriginalFilename", QUASIDOCK_FILE_NAME
            VALUE "ProductName", "quasidock"
            VALUE "ProductVersion", QUASIDOCK_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
