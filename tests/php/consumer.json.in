{
  "id": "test.php.consumer",
  "version": "1",
  "entrypoint": ["${php}\\php.exe", "${app}\\check.php"],
  "from": { "php": "php@@PHP@", "apcu": "php-apcu@@APCU@", "xdebug": "php-xdebug@@XDEBUG@" },
  "env": { "PHP_INI_SCAN_DIR": "${apcu}\\conf.d;${xdebug}\\conf.d;${app}\\conf.d" },
  "permissions": {
    "network": true,
    "filesystem": ["cwd"]
  },
  "stages": [
    {
      "name": "check",
      "sources": [
        { "path": "check.php" },
        { "path": "app.ini", "dest": "conf.d/app.ini" }
      ]
    }
  ]
}
