{
  "id": "test.qt.hello",
  "version": "1",
  "entrypoint": "bin/hello-qt.exe",
  "path": ["bin"],
  "permissions": {
    "filesystem": ["cwd"]
  },
  "from": { "qt": "qt6@@QT@" },
  "sdk": { "qtsdk": "qt6-sdk@@QTSDK@" },
  "stages": [
    {
      "name": "hello",
      "sources": [
        { "path": "CMakeLists.txt" },
        { "path": "hello.cpp" }
      ],
      "build": [
        "cmake -S . -B out -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=\"$PREFIX\"",
        "cmake --build out",
        "cmake --install out"
      ]
    },
    {
      "name": "quick",
      "sources": [
        { "path": "quick/CMakeLists.txt", "dest": "CMakeLists.txt" },
        { "path": "quick/main.cpp", "dest": "main.cpp" },
        { "path": "quick/Main.qml", "dest": "Main.qml" }
      ],
      "build": [
        "cmake -S . -B out -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=\"$PREFIX\"",
        "cmake --build out",
        "cmake --install out"
      ]
    }
  ]
}
