{
  "id": "test.gtk.hello",
  "version": "1",
  "entrypoint": "bin/hello-gtk.exe",
  "path": ["bin"],
  "permissions": {
    "network": true,
    "filesystem": ["cwd"]
  },
  "from": { "gtk": "gtk4@@GTK@" },
  "sdk": { "gtksdk": "gtk4-sdk@@GTKSDK@" },
  "stages": [
    {
      "name": "hello",
      "sources": [
        { "path": "meson.build" },
        { "path": "hello.c" },
        { "path": "soup.c" },
        { "path": "svg.c" },
        { "path": "spell.c" },
        { "path": "font.c" },
        { "path": "icon.c" }
      ],
      "build": ["meson setup out --prefix=\"$PREFIX\"", "meson install -C out"]
    }
  ]
}
