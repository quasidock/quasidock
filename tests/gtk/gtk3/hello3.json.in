{
  "id": "test.gtk.hello3",
  "version": "1",
  "entrypoint": "bin/hello-gtk3.exe",
  "path": ["bin"],
  "permissions": {
    "filesystem": ["cwd"]
  },
  "from": { "gtk": "gtk4@@GTK@", "gtk3": "gtk3@@GTK3@" },
  "sdk": { "gtksdk": "gtk4-sdk@@GTKSDK@", "gtk3sdk": "gtk3-sdk@@GTK3SDK@" },
  "stages": [
    {
      "name": "hello3",
      "sources": [
        { "path": "meson.build" },
        { "path": "hello3.c" }
      ],
      "build": ["meson setup out --prefix=\"$PREFIX\"", "meson install -C out"]
    }
  ]
}
