{
  "id": "test.build.php",
  "version": "1",
  "entrypoint": ["${php}\\php.exe", "${app}\\test.php"],
  "from": { "php": "php@@PHP@", "zprobe": "test.build.phpext@@PHPEXT@" },
  "env": { "PHP_INI_SCAN_DIR": "${zprobe}\\conf.d" },
  "stages": [
    {
      "name": "test",
      "sources": [
        { "path": "test.php" }
      ]
    }
  ]
}
