{
  "id": "test.build.make",
  "version": "1",
  "entrypoint": "bin/hello.exe",
  "sdk": { "make": "make@@MAKE@", "zig": "zig@@ZIG@", "busybox": "busybox@@BUSYBOX@" },
  "stages": [
    {
      "name": "hello",
      "sources": [
        { "path": "Makefile" },
        { "path": "sub.mk" },
        { "path": "main.c", "dest": "src/main.c" },
        { "path": "one.c", "dest": "src/one.c" },
        { "path": "two.c", "dest": "src/two.c" }
      ],
      "build": ["make -j4 install PREFIX=\"$PREFIX\""]
    }
  ]
}
