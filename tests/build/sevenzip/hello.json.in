{
  "id": "test.build.sevenzip",
  "version": "1",
  "entrypoint": "hello.cmd",
  "sdk": { "sevenzip": "7zip@@SEVENZIP@", "busybox": "busybox@@BUSYBOX@" },
  "stages": [
    {
      "name": "hello",
      "sources": [
        { "path": "hello.7z" }
      ],
      "build": ["7z x -y -bd -o\"$PREFIX\" hello.7z"]
    }
  ]
}
