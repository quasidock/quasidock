{
  "id": "test.build.meson",
  "version": "1",
  "entrypoint": "bin/hello.exe",
  "sdk": { "meson": "meson@@MESON@", "zig": "zig@@ZIG@", "busybox": "busybox@@BUSYBOX@" },
  "cleanup": ["/include", "/lib"],
  "stages": [
    {
      "name": "greet",
      "sources": [
        { "path": "greet/meson.build", "dest": "meson.build" },
        { "path": "greet.c" },
        { "path": "greet.h" },
        { "path": "twice.cpp" }
      ],
      "build": ["meson setup out --prefix=\"$PREFIX\"", "meson install -C out"]
    },
    {
      "name": "hello",
      "sources": [
        { "path": "hello/meson.build", "dest": "meson.build" },
        { "path": "main.c" },
        { "path": "hello.rc" }
      ],
      "build": ["meson setup out --prefix=\"$PREFIX\"", "meson install -C out"]
    }
  ]
}
