{
  "id": "test.build.dotnetdesktop",
  "version": "1",
  "entrypoint": "desktop.exe",
  "from": { "dotnet": "dotnet@@DOTNET@" },
  "sdk": { "dotnetsdk": "dotnet-sdk@@DOTNETSDK@", "busybox": "busybox@@BUSYBOX@" },
  "stages": [
    {
      "name": "desktop",
      "sources": [
        { "path": "desktop.csproj" },
        { "path": "Program.cs" }
      ],
      "build": ["dotnet publish -c Release -o \"$PREFIX\""]
    }
  ]
}
