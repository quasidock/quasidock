{
  "id": "test.build.rust",
  "version": "1",
  "entrypoint": "hello.exe",
  "sdk": { "rust": "rust@@RUST@", "zig": "zig@@ZIG@", "busybox": "busybox@@BUSYBOX@" },
  "stages": [
    {
      "name": "hello",
      "sources": [
        { "path": "Cargo.toml" },
        { "path": "Cargo.lock" },
        { "path": "build.rs" },
        { "path": "greet.c" },
        { "path": "main.rs", "dest": "src/main.rs" }
      ],
      "vendor": {
        "commands": ["cargo vendor --locked vendor >/dev/null"],
        "dir": "vendor",
        "sha256": "1f67b94a71fe262b1d26daf6f2b903402c018bb30f28845722a4835ca8784d20"
      },
      "build": [
        "cargo build --offline --locked --release --config 'source.crates-io.replace-with=\"vendored\"' --config 'source.vendored.directory=\"vendor\"'",
        "cp target/release/hello.exe \"$PREFIX/hello.exe\""
      ]
    }
  ]
}
