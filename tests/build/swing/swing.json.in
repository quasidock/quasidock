{
  "id": "test.build.swing",
  "version": "1",
  "entrypoint": ["${java}\\bin\\java.exe", "-jar", "${app}\\swing.jar"],
  "from": { "java": "java@@JAVA@" },
  "sdk": { "jdk": "java-sdk@@JAVASDK@", "busybox": "busybox@@BUSYBOX@" },
  "stages": [
    {
      "name": "swing",
      "sources": [
        { "path": "Swing.java" }
      ],
      "build": [
        "javac -d classes Swing.java",
        "jar --create --file \"$PREFIX/swing.jar\" --main-class Swing --date 2026-01-01T00:00:02Z -C classes ."
      ]
    }
  ]
}
