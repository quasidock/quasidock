{
  "id": "test.build.dotnet",
  "version": "1",
  "entrypoint": "hello.exe",
  "from": { "dotnet": "dotnet@@DOTNET@" },
  "sdk": { "dotnetsdk": "dotnet-sdk@@DOTNETSDK@", "busybox": "busybox@@BUSYBOX@" },
  "stages": [
    {
      "name": "hello",
      "sources": [
        { "path": "hello.csproj" },
        { "path": "Program.cs" }
      ],
      "vendor": {
        "commands": ["dotnet restore --packages vendor"],
        "dir": "vendor",
        "sha256": "38a3059f4fc43ff4b8388ea17d7bd375c685626b802f081f752bddd7546894d4"
      },
      "build": ["dotnet publish -c Release --packages vendor --source \"$PWD/vendor\" -o \"$PREFIX\""]
    }
  ]
}
