{
  "id": "test.build.cmake",
  "version": "1",
  "entrypoint": "bin/hello.exe",
  "sdk": { "cmake": "cmake@@CMAKE@", "zig": "zig@@ZIG@", "busybox": "busybox@@BUSYBOX@" },
  "cleanup": ["/include", "/lib"],
  "stages": [
    {
      "name": "hello",
      "sources": [
        { "path": "CMakeLists.txt" },
        { "path": "greet.c" },
        { "path": "greet.h" },
        { "path": "twice.cpp" },
        { "path": "main.c" },
        { "path": "hello.rc" }
      ],
      "build": [
        "cmake -S . -B out -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=\"$PREFIX\"",
        "cmake --build out",
        "cmake --install out"
      ]
    }
  ]
}
