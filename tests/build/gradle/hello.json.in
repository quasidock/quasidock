{
  "id": "test.build.gradle",
  "version": "1",
  "entrypoint": ["${java}\\bin\\java.exe", "-jar", "${app}\\hello.jar"],
  "from": { "java": "java@@JAVA@" },
  "sdk": { "gradle": "gradle@@GRADLE@", "busybox": "busybox@@BUSYBOX@" },
  "stages": [
    {
      "name": "hello",
      "sources": [
        { "path": "settings.gradle" },
        { "path": "build.gradle" },
        { "path": "Hello.java", "dest": "src/main/java/Hello.java" }
      ],
      "vendor": {
        "commands": ["gradle -g gradle-home stage", "gradle-vendor gradle-home vendor"],
        "dir": "vendor",
        "sha256": "db850a04ba97ee4f537bc62f669caabb99a7c6ef4f57968b8a259894627bb825"
      },
      "build": ["ZIGSAW_GRADLE_REPO=\"$PWD/vendor\" gradle --offline stage", "cp -r build/stage/. \"$PREFIX/\""]
    }
  ]
}
