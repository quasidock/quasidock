{
  "id": "test.build.go",
  "version": "1",
  "entrypoint": "hello.exe",
  "sdk": { "go": "go@@GO@", "busybox": "busybox@@BUSYBOX@" },
  "stages": [
    {
      "name": "hello",
      "sources": [
        { "path": "go.mod" },
        { "path": "main.go" }
      ],
      "env": { "CGO_ENABLED": "0" },
      "build": ["go build -o \"$PREFIX/hello.exe\" ."]
    }
  ]
}
