{
  "id": "test.build.cgo",
  "version": "1",
  "entrypoint": "hello.exe",
  "sdk": { "go": "go@@GO@", "zig": "zig@@ZIG@", "busybox": "busybox@@BUSYBOX@" },
  "stages": [
    {
      "name": "hello",
      "sources": [
        { "path": "go.mod" },
        { "path": "main.go" },
        { "path": "greet.c" },
        { "path": "greet.h" }
      ],
      "build": ["go build -ldflags=-buildid= -o \"$PREFIX/hello.exe\" ."]
    }
  ]
}
