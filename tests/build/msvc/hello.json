{
  "id": "test.build.msvc",
  "version": "1",
  "entrypoint": "bin/hello.exe",
  "host": ["msvc"],
  "stages": [
    {
      "name": "hello",
      "shell": "cmd",
      "sources": [
        { "path": "hello.c" }
      ],
      "build": ["cl /nologo /O2 /Brepro hello.c /link /Brepro", "mkdir %PREFIX%\\bin && copy hello.exe %PREFIX%\\bin\\"]
    }
  ]
}
