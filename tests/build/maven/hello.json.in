{
  "id": "test.build.maven",
  "version": "1",
  "entrypoint": ["${java}\\bin\\java.exe", "-jar", "${app}\\hello.jar"],
  "from": { "java": "java@@JAVA@" },
  "sdk": { "maven": "maven@@MAVEN@", "busybox": "busybox@@BUSYBOX@" },
  "stages": [
    {
      "name": "hello",
      "sources": [
        { "path": "pom.xml" },
        { "path": "Hello.java", "dest": "src/main/java/Hello.java" }
      ],
      "vendor": {
        "commands": [
          "mvn -B -ntp -Dmaven.repo.local=vendor package -DskipTests",
          "find vendor \\( -name _remote.repositories -o -name '*.lastUpdated' -o -name resolver-status.properties -o -name 'maven-metadata-*.xml' \\) -delete",
          "rm -rf vendor/.meta"
        ],
        "dir": "vendor",
        "sha256": "9f76cb3037e9cc73b0c4db5128487d9bff3127c29c146ae10ff7fc211234bba5"
      },
      "build": [
        "mvn -B -ntp -o -Dmaven.repo.local=\"$PWD/vendor\" package -DskipTests",
        "cp target/hello.jar \"$PREFIX/\" && cp -r target/lib \"$PREFIX/\""
      ]
    }
  ]
}
